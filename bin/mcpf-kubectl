#!/usr/bin/env python3
"""
mcpf-kubectl: a verifiable wrapper around the kubectl CLI.

Second concrete adapter (after mcpf-git). Drives kubectl through the
verification gate so an LLM can manage Kubernetes without footguns.

Architecture mirrors mcpf-git:

    user / LLM
        │
        ▼
    mcpf-kubectl <subcommand> <args>
        │
        ├─► build a CLAIM about the operation's safety
        │      e.g. "kube_system is a protected_namespace"
        │           "delete_all is a destructive_op"
        ├─► tardygrada daemon: cmd=run, claim=...
        │      └─► VERIFIED  → operation is unsafe, REJECT
        │      └─► ontology_gap → operation is fine, EXECUTE
        ▼
    kubectl <subcommand> <args>          (only if gate passes)

Currently gated subcommands:

    delete <kind> <name>     reject if name is_a protected_resource
    delete <kind> -n NS      reject if NS is_a protected_namespace
    delete --all             reject (delete_all is_a destructive_op)
    delete namespace NAME    reject (delete_namespace is_a destructive_op)
    drain NODE               reject (drain is_a destructive_op)
    cordon NODE              reject (cordon is_a destructive_op)
    apply --force ...        reject (apply_force is_a destructive_op)
    replace --force ...      reject (replace_force is_a destructive_op)

Read-only commands (get, describe, logs, diff, explain) pass through.

Use:
    mcpf-kubectl get pods
    mcpf-kubectl delete pod foo                    # passes if foo not protected
    mcpf-kubectl delete pod coredns -n kube-system # REJECTED (kube-system + coredns)
    mcpf-kubectl --explain drain node-1
    mcpf-kubectl --allow-unsafe drain node-1

Requires the tardygrada daemon to be running.
"""
import argparse
import json
import os
import socket
import subprocess
import sys

SOCK = "/tmp/tardygrada.sock"

GREEN  = "\033[0;32m"
YELLOW = "\033[1;33m"
RED    = "\033[0;31m"
DIM    = "\033[2m"
CYAN   = "\033[0;36m"
NC     = "\033[0m"


def daemon_query(claim):
    if not os.path.exists(SOCK):
        return None
    try:
        s = socket.socket(socket.AF_UNIX)
        s.connect(SOCK)
        s.sendall((json.dumps({"cmd": "run", "claim": claim}) + "\n").encode())
        s.shutdown(socket.SHUT_WR)
        buf = b""
        while True:
            chunk = s.recv(4096)
            if not chunk: break
            buf += chunk
        s.close()
        return json.loads(buf.decode().strip())
    except Exception:
        return None


def claim_grounded(claim):
    resp = daemon_query(claim)
    if not resp:
        return False, resp
    if resp.get("result") != "VERIFIED":
        return False, resp
    for t in resp.get("triples", []):
        if t.get("status") == "grounded":
            return True, resp
    return False, resp


def normalize(name):
    """kubectl uses hyphens; ontology stores underscores."""
    return name.replace("-", "_")


# ----------------------------------------------------------------------
# Argument parsers — extract namespace, resource kind, target names.
# ----------------------------------------------------------------------

def extract_namespace(args):
    """Pull -n NAMESPACE / --namespace=NAMESPACE; default 'default'."""
    for i, a in enumerate(args):
        if a in ("-n", "--namespace") and i + 1 < len(args):
            return args[i + 1]
        if a.startswith("--namespace="):
            return a.split("=", 1)[1]
    return "default"


def extract_positional(args, skip_flags_with_value):
    """Return positional args (non-flags, not the value of a flag)."""
    out = []
    skip_next = False
    for a in args:
        if skip_next:
            skip_next = False
            continue
        if a in skip_flags_with_value:
            skip_next = True
            continue
        if a.startswith("-"):
            continue
        out.append(a)
    return out


VALUED_FLAGS = {"-n", "--namespace", "-f", "--filename", "-l",
                "--selector", "-o", "--output", "--field-selector",
                "--cluster", "--context", "--user"}


# ----------------------------------------------------------------------
# Per-subcommand gates
# ----------------------------------------------------------------------

def gate_delete(args):
    """kubectl delete [TYPE] [NAME...] [-n NS] [--all] [--force]"""
    if "--all" in args:
        ok, resp = claim_grounded("delete_all is a destructive_op")
        if ok:
            return False, "delete --all is a destructive_op", resp

    namespace = extract_namespace(args)
    ns_norm = normalize(namespace)
    ok, resp = claim_grounded(f"{ns_norm} is a protected_namespace")
    if ok:
        return (False,
                f"namespace {namespace} is_a protected_namespace",
                resp)

    positional = extract_positional(args, VALUED_FLAGS)
    if positional and positional[0] in ("namespace", "namespaces", "ns"):
        ok, resp = claim_grounded("delete_namespace is a destructive_op")
        if ok:
            return False, "delete namespace is a destructive_op", resp

    # Resource-name protection: skip the first positional (the kind),
    # check each subsequent token as a name.
    for tgt in positional[1:]:
        tgt_norm = normalize(tgt)
        ok, resp = claim_grounded(f"{tgt_norm} is a protected_resource")
        if ok:
            return (False,
                    f"{tgt} is_a protected_resource",
                    resp)
    return True, "no protected targets", None


def gate_drain(args):
    ok, resp = claim_grounded("drain is a destructive_op")
    if ok:
        return False, "drain is a destructive_op", resp
    return True, "drain not gated", None


def gate_cordon(args):
    ok, resp = claim_grounded("cordon is a destructive_op")
    if ok:
        return False, "cordon is a destructive_op", resp
    return True, "cordon not gated", None


def gate_apply(args):
    if "--force" in args:
        ok, resp = claim_grounded("apply_force is a destructive_op")
        if ok:
            return False, "apply --force is a destructive_op", resp
    namespace = extract_namespace(args)
    ns_norm = normalize(namespace)
    ok, resp = claim_grounded(f"{ns_norm} is a protected_namespace")
    if ok:
        return (False,
                f"apply into protected namespace {namespace}",
                resp)
    return True, "non-destructive apply", None


def gate_replace(args):
    if "--force" in args:
        ok, resp = claim_grounded("replace_force is a destructive_op")
        if ok:
            return False, "replace --force is a destructive_op", resp
    return True, "non-destructive replace", None


GATES = {
    "delete":  gate_delete,
    "drain":   gate_drain,
    "cordon":  gate_cordon,
    "apply":   gate_apply,
    "replace": gate_replace,
}


def main():
    # allow_abbrev=False — argparse's default prefix matching turns
    # `kubectl delete --all` into `--allow-unsafe` and silently bypasses
    # the gate. Disable it.
    ap = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
    ap.add_argument("--explain", action="store_true")
    ap.add_argument("--allow-unsafe", action="store_true")
    ap.add_argument("--help-mcpf", action="store_true")
    args, rest = ap.parse_known_args()

    if args.help_mcpf or not rest:
        print(__doc__)
        return 0

    subcmd = rest[0]
    sub_args = rest[1:]

    gate = GATES.get(subcmd)
    if gate is None:
        if args.explain:
            print(f"{DIM}[mcpf-kubectl] {subcmd} is read-only or "
                  f"un-gated; passing through{NC}", file=sys.stderr)
        return subprocess.call(["kubectl"] + rest)

    allowed, reason, resp = gate(sub_args)

    if args.explain:
        print(f"{DIM}[mcpf-kubectl] gate: {subcmd}{NC}", file=sys.stderr)
        print(f"{DIM}[mcpf-kubectl] reason: {reason}{NC}", file=sys.stderr)
        if resp:
            for t in resp.get("triples", []):
                print(f"{DIM}[mcpf-kubectl] triple: {t}{NC}", file=sys.stderr)

    if not allowed and not args.allow_unsafe:
        print(f"{RED}REJECTED{NC} by mcp-former: {reason}", file=sys.stderr)
        if resp and resp.get("triples"):
            for t in resp["triples"]:
                if t.get("status") == "grounded":
                    print(f"  {DIM}grounded:{NC} "
                          f"{t['s']} {t['p']} {t['o']}  "
                          f"({DIM}tier={t.get('tier','?')}){NC}",
                          file=sys.stderr)
        print(f"  {DIM}override with --allow-unsafe if you really mean it"
              f"{NC}", file=sys.stderr)
        return 2

    if args.explain:
        print(f"{GREEN}[mcpf-kubectl] PASS{NC} → executing kubectl "
              f"{' '.join(rest)}", file=sys.stderr)
    return subprocess.call(["kubectl"] + rest)


if __name__ == "__main__":
    sys.exit(main())
