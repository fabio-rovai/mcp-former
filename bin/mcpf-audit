#!/usr/bin/env python3
"""
mcpf audit — conformance test for an mcp-former wrapper bundle.

Runs pytest-style checks that a generated bundle (or a registry
wrapper) maps 1-to-1 to the underlying tool's actual surface area,
and surfaces deviations.

Checks:

  [existence]   Every `<op> is_a destructive_op` fact corresponds to
                a real subcommand or flag of the binary. Verified by
                shelling out to `<binary> <verb> --help`.
  [coverage]    Every destructive-keyword-matching subcommand in the
                tool's `--help` output is represented in the ontology.
                Catches gaps the LLM missed.
  [sanity]      Every fact parses as valid N-Triples and uses
                approved predicate vocabulary (is_a only, for now).
  [grounding]   For each protection fact, the tardygrada daemon
                (when running) actually grounds the matching claim.
                Catches "fact written but not loaded" bugs.

Output: pytest-style PASS/FAIL/SKIP per test, summary at the end,
exit code reflects pass/fail for CI use.

Use:
    mcpf audit /path/to/bundle              # audit a generated bundle
    mcpf audit git                          # audit a registry wrapper
    mcpf audit --binary rclone PATH         # custom binary path
    mcpf audit --no-coverage BUNDLE         # skip the coverage check
    mcpf audit --json BUNDLE                # machine-readable output
"""
import argparse
import json
import os
import re
import shutil
import socket
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

GREEN  = "\033[0;32m"
YELLOW = "\033[1;33m"
RED    = "\033[0;31m"
DIM    = "\033[2m"
CYAN   = "\033[0;36m"
NC     = "\033[0m"

NT_RE = re.compile(
    r'^<[^>]*org/(?P<s>[^>]+)>\s+<[^>]*org/(?P<p>[^>]+)>\s+'
    r'<[^>]*org/(?P<o>[^>]+)>\s*\.\s*$')

DESTRUCTIVE_KEYWORDS = (
    "delete", "remove", "destroy", "discard", "purge", "expire",
    "prune", "wipe", "force", "drain", "evict", "uninstall",
    "drop", "truncate", "rmdir", "rm-rf", "terminate", "shutdown",
    "kill", "clean",
)


# ----------------------------------------------------------------------
# Locating the bundle and its assets
# ----------------------------------------------------------------------

def resolve_bundle(target):
    """`target` is either a path to a bundle directory, or a registry
    name (git, kubectl, …). Returns (bundle_path, ontology_path,
    binary_name)."""
    p = Path(target)
    if p.exists() and p.is_dir():
        # Bundle directory
        ontologies = list((p / "ontologies").glob("*.nt"))
        if not ontologies:
            raise RuntimeError(f"no .nt file in {p}/ontologies/")
        ont = ontologies[0]
        # Binary name from the ontology filename or the adapter
        binary = ont.stem
        adapter = next((p / "bin").glob("mcpf-*"), None)
        if adapter:
            binary = adapter.name.replace("mcpf-", "")
        return p, ont, binary

    # Registry name
    registry = json.loads((ROOT / "registry" / "index.json").read_text())
    entry = next((w for w in registry["wrappers"] if w["name"] == target),
                  None)
    if not entry:
        raise RuntimeError(f"unknown wrapper: {target}")
    return (None,
            ROOT / entry["ontology_path"],
            entry["binary"])


def parse_ontology(path):
    """Yield (s, p, o) tuples plus header lines for stats."""
    triples = []
    with open(path) as f:
        for line in f:
            m = NT_RE.match(line.strip())
            if m:
                triples.append((m.group("s"), m.group("p"),
                                 m.group("o")))
    return triples


# ----------------------------------------------------------------------
# Test machinery — pytest-lite
# ----------------------------------------------------------------------

class Result:
    def __init__(self):
        self.passed = []
        self.failed = []
        self.skipped = []

    def pass_(self, name, detail=""):
        self.passed.append((name, detail))

    def fail(self, name, detail):
        self.failed.append((name, detail))

    def skip(self, name, reason):
        self.skipped.append((name, reason))

    @property
    def total(self):
        return len(self.passed) + len(self.failed) + len(self.skipped)

    @property
    def ok(self):
        return not self.failed


# ----------------------------------------------------------------------
# Check 1 — existence: each destructive_op verb has a help page
# ----------------------------------------------------------------------

def check_existence(triples, binary, result, verbose):
    if not shutil.which(binary):
        result.skip("existence", f"{binary} not on PATH")
        return

    op_facts = [(s, p, o) for (s, p, o) in triples
                 if o == "destructive_op"]
    if not op_facts:
        result.skip("existence", "no destructive_op facts in ontology")
        return

    # Strip <binary>_ prefix so we test the raw verb. Skip facts that
    # look like flag patterns (contain "flag").
    for (s, p, o) in op_facts:
        verb = s
        if verb.startswith(f"{binary}_"):
            verb = verb[len(binary) + 1:]
        if "flag" in verb:
            continue
        if "_" in verb:
            # noun_verb form like config_delete; try as noun.verb syntax
            verb_parts = verb.split("_")
            verb = verb_parts[0]
        # Try `binary verb --help`
        r = subprocess.run([binary, verb, "--help"],
                           capture_output=True, text=True, timeout=10)
        # Some CLIs return non-zero on --help but still output text
        ok = (r.returncode == 0 or "Usage" in (r.stdout + r.stderr) or
              verb in (r.stdout + r.stderr).lower())
        if ok:
            result.pass_(f"existence: {s}",
                          f"{binary} {verb} --help responded")
            if verbose:
                print(f"  {DIM}{GREEN}✓{NC} {DIM}existence:{NC} {s}")
        else:
            preview = (r.stderr or r.stdout).strip().splitlines()
            preview = preview[0] if preview else "(no output)"
            result.fail(f"existence: {s}",
                         f"`{binary} {verb} --help` returned no usage "
                         f"info: {preview[:80]}")
            if verbose:
                print(f"  {RED}✗{NC} {DIM}existence:{NC} {s} — {preview[:80]}")


# ----------------------------------------------------------------------
# Check 2 — coverage: destructive verbs in --help that aren't in ontology
# ----------------------------------------------------------------------

def check_coverage(triples, binary, result, verbose):
    if not shutil.which(binary):
        result.skip("coverage", f"{binary} not on PATH")
        return

    r = subprocess.run([binary, "--help"], capture_output=True,
                        text=True, timeout=10)
    text = (r.stdout + r.stderr).lower()
    if not text:
        result.skip("coverage", "no --help output")
        return

    # Extract candidate subcommands. CLIs typically list them as
    # indented lines: "  delete   Delete a thing".
    line_re = re.compile(r"^\s{2,4}([a-z][a-z0-9-]+)\s+\S")
    candidates = set()
    for line in text.splitlines():
        m = line_re.match(line)
        if m:
            cmd = m.group(1).replace("-", "_")
            if any(kw in cmd or kw in line.lower()
                    for kw in DESTRUCTIVE_KEYWORDS):
                candidates.add(cmd)

    # Subjects in the ontology, stripped of binary prefix
    onto_verbs = set()
    for (s, p, o) in triples:
        if o == "destructive_op":
            v = s
            if v.startswith(f"{binary}_"):
                v = v[len(binary) + 1:]
            onto_verbs.add(v)

    missing = candidates - onto_verbs
    extra = onto_verbs - candidates

    if not missing:
        result.pass_(
            "coverage", f"{len(candidates)} destructive verbs in "
                        f"--help, all in ontology")
    else:
        result.fail(
            "coverage", f"{len(missing)} verbs in --help missing from "
                        f"ontology: {', '.join(sorted(missing))}")
    if verbose:
        if missing:
            print(f"  {RED}✗{NC} {DIM}coverage:{NC} missing from "
                  f"ontology: {sorted(missing)}")
        if extra:
            print(f"  {YELLOW}~{NC} {DIM}coverage:{NC} in ontology but "
                  f"NOT in --help (may be flags or hallucinations): "
                  f"{sorted(extra)[:5]}")


# ----------------------------------------------------------------------
# Check 3 — sanity: the .nt file uses approved vocabulary only
# ----------------------------------------------------------------------

ALLOWED_PREDICATES = {"is_a"}
ALLOWED_OBJECTS = {
    "destructive_op", "operation", "protected_thing", "protected_branch",
    "protected_ref", "protected_namespace", "protected_resource",
    "protected_database", "protected_schema", "protected_role",
    "protected_repo", "protected_service", "protected_tag",
    # Domain layer
    "resource", "git_object", "ref", "branch", "tag", "commit",
    "working_tree", "kubernetes_resource", "namespace", "pod",
    "deployment", "service", "node", "cluster", "aws_resource",
    "aws_service", "ec2_instance", "s3_bucket", "rds_instance",
    "lambda_fn", "cfn_stack", "iam_principal", "gh_resource",
    "repo", "release", "issue", "secret", "codespace",
    "psql_resource", "database", "db_schema", "table", "role",
    "extension", "tool",
    # Per-tool destructive subclasses (snake_case)
    "git_destructive_op", "kubectl_destructive_op", "gh_destructive_op",
    "aws_destructive_op", "psql_destructive_op",
}


def check_sanity(triples, result, verbose):
    if not triples:
        result.fail("sanity", "ontology is empty")
        return
    bad_pred = []
    bad_obj = []
    for (s, p, o) in triples:
        if p not in ALLOWED_PREDICATES:
            bad_pred.append((s, p, o))
        if o not in ALLOWED_OBJECTS:
            bad_obj.append((s, p, o))
    if not bad_pred and not bad_obj:
        result.pass_("sanity",
                      f"{len(triples)} triples, all in approved vocabulary")
        return
    msgs = []
    if bad_pred:
        msgs.append(f"{len(bad_pred)} unknown predicates "
                     f"(e.g. {bad_pred[0][1]})")
    if bad_obj:
        msgs.append(f"{len(bad_obj)} unknown objects "
                     f"(e.g. {bad_obj[0][2]})")
    result.fail("sanity", "; ".join(msgs))
    if verbose:
        for (s, p, o) in (bad_pred + bad_obj)[:5]:
            print(f"  {YELLOW}~{NC} {DIM}sanity:{NC} {s} {p} {o}")


# ----------------------------------------------------------------------
# Check 4 — grounding: each fact verifies via the daemon
# ----------------------------------------------------------------------

SOCK = "/tmp/tardygrada.sock"


def daemon_query(claim):
    if not os.path.exists(SOCK):
        return None
    try:
        s = socket.socket(socket.AF_UNIX); s.connect(SOCK)
        s.sendall((json.dumps({"cmd": "run", "claim": claim}) + "\n").encode())
        s.shutdown(socket.SHUT_WR)
        buf = b""
        while True:
            chunk = s.recv(4096)
            if not chunk: break
            buf += chunk
        s.close()
        return json.loads(buf.decode().strip())
    except Exception:
        return None


def check_grounding(triples, result, verbose):
    if not os.path.exists(SOCK):
        result.skip("grounding", "tardygrada daemon not running")
        return
    sample = triples[:30]   # sampling cap
    grounded = 0
    not_grounded = []
    for (s, p, o) in sample:
        if p != "is_a":
            continue
        resp = daemon_query(f"{s} is a {o}")
        if resp and resp.get("result") == "VERIFIED" and any(
                t.get("status") == "grounded"
                for t in resp.get("triples", [])):
            grounded += 1
        else:
            not_grounded.append((s, o))
    if not not_grounded:
        result.pass_("grounding",
                      f"{grounded}/{len(sample)} sampled facts ground "
                      f"in the daemon")
    else:
        result.fail("grounding",
                     f"{len(not_grounded)} facts in ontology don't "
                     f"ground (run `mcpf reload` after editing). "
                     f"first miss: {not_grounded[0][0]} is_a "
                     f"{not_grounded[0][1]}")
    if verbose and not_grounded:
        for (s, o) in not_grounded[:5]:
            print(f"  {RED}✗{NC} {DIM}grounding:{NC} {s} is_a {o}")


# ----------------------------------------------------------------------
# Output formatting
# ----------------------------------------------------------------------

def emit_text(target, binary, ontology, triples, result):
    print(f"\n{CYAN}mcp-former audit: {target}{NC}")
    print(f"{DIM}═══════════════════════════════════════════════════{NC}")
    print(f"  binary:    {binary}"
          f"{' ' + DIM + '(found at ' + (shutil.which(binary) or '?') + ')' + NC if shutil.which(binary) else ' ' + YELLOW + '(not on PATH)' + NC}")
    print(f"  ontology:  {ontology} {DIM}({len(triples)} facts){NC}")
    print()
    for name, detail in result.passed:
        print(f"  {GREEN}✓{NC} {name:32s}  {DIM}{detail}{NC}")
    for name, reason in result.skipped:
        print(f"  {YELLOW}-{NC} {name:32s}  {DIM}skip: {reason}{NC}")
    for name, detail in result.failed:
        print(f"  {RED}✗{NC} {name:32s}  {detail}")
    print()
    print(f"{DIM}═══════════════════════════════════════════════════{NC}")
    p, f, s = len(result.passed), len(result.failed), len(result.skipped)
    status_color = GREEN if result.ok else RED
    status = "PASS" if result.ok else "FAIL"
    print(f"  {status_color}{status}{NC}: {p} passed, {f} failed, "
          f"{s} skipped (of {result.total})")
    if not result.ok:
        print(f"  {DIM}exit code: 1{NC}")


def emit_json(target, binary, ontology, triples, result):
    print(json.dumps({
        "target": target,
        "binary": binary,
        "ontology": str(ontology),
        "fact_count": len(triples),
        "passed": [{"name": n, "detail": d} for n, d in result.passed],
        "failed": [{"name": n, "detail": d} for n, d in result.failed],
        "skipped": [{"name": n, "reason": r} for n, r in result.skipped],
        "ok": result.ok,
    }, indent=2))


# ----------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("target",
        help="bundle directory or registry wrapper name")
    ap.add_argument("--binary", default=None,
        help="override the binary name to test against")
    ap.add_argument("--no-existence", action="store_true",
        help="skip the existence check")
    ap.add_argument("--no-coverage", action="store_true",
        help="skip the coverage check")
    ap.add_argument("--no-grounding", action="store_true",
        help="skip the daemon-grounding check")
    ap.add_argument("--json", action="store_true",
        help="emit JSON instead of human-readable output")
    ap.add_argument("-v", "--verbose", action="store_true",
        help="print per-test progress")
    args = ap.parse_args()

    try:
        bundle, ontology, binary = resolve_bundle(args.target)
    except RuntimeError as e:
        print(f"{RED}{e}{NC}", file=sys.stderr)
        return 2
    if args.binary:
        binary = args.binary

    triples = parse_ontology(ontology)
    result = Result()

    check_sanity(triples, result, args.verbose)
    if not args.no_existence:
        check_existence(triples, binary, result, args.verbose)
    if not args.no_coverage:
        check_coverage(triples, binary, result, args.verbose)
    if not args.no_grounding:
        check_grounding(triples, result, args.verbose)

    if args.json:
        emit_json(args.target, binary, ontology, triples, result)
    else:
        emit_text(args.target, binary, ontology, triples, result)
    return 0 if result.ok else 1


if __name__ == "__main__":
    sys.exit(main())
