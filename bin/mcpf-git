#!/usr/bin/env python3
"""
mcpf-git: a verifiable wrapper around the git CLI.

The first concrete demonstration of the mcp-former thesis: a real
piece of legacy software (git) wrapped behind verification, so an LLM
(or human) can drive it without footguns.

Architecture:

    user / LLM
        │
        ▼
    mcpf-git <subcommand> <args>
        │
        ├─► build a CLAIM about the operation's safety
        │      e.g. "main is a protected_branch"
        ├─► tardygrada daemon: cmd=run, claim=...
        │      └─► VERIFIED  → operation is unsafe, REJECT
        │      └─► ontology_gap → operation is fine, EXECUTE
        ▼
    git <subcommand> <args>          (only if gate passes)

The gate is data-driven: ontologies/git.nt lists protected branches,
protected refs, and destructive operations. Adding a new protected
branch is a one-line edit (or a runtime tardygrada submit-fact),
not a code change.

Currently gated subcommands:
    branch -d/-D NAME       reject if NAME is_a protected_branch
    push --force ...        reject (push_force is_a destructive_op)
    push -f ...             alias of push --force
    reset --hard ...        reject (reset_hard is_a destructive_op)
    clean -f / -fd          reject (clean_force is_a destructive_op)
    checkout -- PATH        reject (checkout_discard is_a destructive_op)

Read-only subcommands pass through unverified.

Use:
    mcpf-git status                 # passthrough
    mcpf-git branch -D feature-x    # ungrounded, executes
    mcpf-git branch -D main         # grounded, REJECTED
    mcpf-git --explain branch -D main
    mcpf-git --allow-unsafe branch -D main

The tardygrada daemon must be running:
    tardygrada daemon start
"""
import argparse
import json
import os
import socket
import subprocess
import sys

SOCK = "/tmp/tardygrada.sock"

GREEN  = "\033[0;32m"
YELLOW = "\033[1;33m"
RED    = "\033[0;31m"
DIM    = "\033[2m"
CYAN   = "\033[0;36m"
NC     = "\033[0m"


def daemon_query(claim):
    if not os.path.exists(SOCK):
        return None
    try:
        s = socket.socket(socket.AF_UNIX)
        s.connect(SOCK)
        s.sendall((json.dumps({"cmd": "run", "claim": claim}) + "\n").encode())
        s.shutdown(socket.SHUT_WR)
        buf = b""
        while True:
            chunk = s.recv(4096)
            if not chunk: break
            buf += chunk
        s.close()
        return json.loads(buf.decode().strip())
    except Exception:
        return None


def claim_grounded(claim):
    """True if the claim verifies AND there's at least one grounded
    triple — guards against false positives from frame-shape matches."""
    resp = daemon_query(claim)
    if not resp:
        return False, resp
    if resp.get("result") != "VERIFIED":
        return False, resp
    for t in resp.get("triples", []):
        if t.get("status") == "grounded":
            return True, resp
    return False, resp


# ----------------------------------------------------------------------
# Per-subcommand gates. Each returns (allowed, reason, response_json).
# ----------------------------------------------------------------------

def gate_branch(args):
    """Domain-aware variant: queries against the OWL :ProtectedThing
    superclass. After OWL-RL closure, anything that's a :ProtectedBranch
    is also a :ProtectedRef and a :ProtectedThing — so a single
    `is a protected_thing` query covers branches, tags, refs, and any
    future protected category we add to the schema. The gate doesn't
    need to know about each subclass."""
    delete = False
    targets = []
    for a in args:
        if a in ("-d", "-D", "--delete", "--force"):
            delete = True
        elif a in ("-r", "--remotes", "-a", "--all", "-v", "-vv",
                   "--list", "--show-current", "-q", "--quiet"):
            pass
        elif a.startswith("-"):
            pass
        else:
            targets.append(a)
    if not delete or not targets:
        return True, "read-only branch operation", None
    for tgt in targets:
        # Domain-aware: protected_thing covers ProtectedBranch ∪ ProtectedRef ∪
        # any future subclass — added without touching this code.
        ok, resp = claim_grounded(f"{tgt} is a protected_thing")
        if ok:
            # Surface the most-specific subclass for the message — try
            # the common ones individually so we don't depend on
            # response order. Fall back to "protected_thing".
            specific = "protected_thing"
            for cls in ("protected_branch", "protected_ref",
                        "protected_resource", "protected_namespace",
                        "protected_repo", "protected_tag"):
                sub_resp = daemon_query(f"{tgt} is a {cls}")
                if sub_resp and sub_resp.get("result") == "VERIFIED":
                    if any(t.get("status") == "grounded"
                           for t in sub_resp.get("triples", [])):
                        specific = cls
                        break
            return False, f"{tgt} is a {specific}", resp
    return True, "no protected refs in target list", None


def gate_push(args):
    if any(a in ("--force", "-f") for a in args):
        ok, resp = claim_grounded("push_force is a destructive_op")
        if ok:
            return False, "push --force is a destructive_op", resp
    if "--force-with-lease" in args:
        return True, "push --force-with-lease is the safe variant", None
    return True, "non-destructive push", None


def gate_reset(args):
    if "--hard" in args:
        ok, resp = claim_grounded("reset_hard is a destructive_op")
        if ok:
            return False, "reset --hard is a destructive_op", resp
    return True, "non-destructive reset", None


def gate_clean(args):
    if any(a in ("-f", "--force", "-fd", "-df", "-fdx", "-fX") for a in args):
        ok, resp = claim_grounded("clean_force is a destructive_op")
        if ok:
            return False, "clean -f is a destructive_op", resp
    return True, "non-destructive clean (would dry-run)", None


def gate_checkout(args):
    if "--" in args:
        ok, resp = claim_grounded("checkout_discard is a destructive_op")
        if ok:
            return False, "checkout -- discards working-tree changes", resp
    return True, "non-destructive checkout", None


GATES = {
    "branch":   gate_branch,
    "push":     gate_push,
    "reset":    gate_reset,
    "clean":    gate_clean,
    "checkout": gate_checkout,
}


def main():
    # allow_abbrev=False — argparse's default prefix matching otherwise
    # turns flags like `--all` (`git branch --all`) into `--allow-unsafe`
    # and silently bypasses the gate.
    ap = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
    ap.add_argument("--explain", action="store_true")
    ap.add_argument("--allow-unsafe", action="store_true")
    ap.add_argument("--help-mcpf", action="store_true")
    args, rest = ap.parse_known_args()

    if args.help_mcpf or not rest:
        print(__doc__)
        return 0

    subcmd = rest[0]
    sub_args = rest[1:]

    gate = GATES.get(subcmd)
    if gate is None:
        if args.explain:
            print(f"{DIM}[mcpf-git] {subcmd} is read-only or "
                  f"un-gated; passing through{NC}", file=sys.stderr)
        try:
            return subprocess.call(["git"] + rest)
        except FileNotFoundError:
            print(f"{RED}git not found on PATH.{NC}", file=sys.stderr)
            return 127

    allowed, reason, resp = gate(sub_args)

    if args.explain:
        print(f"{DIM}[mcpf-git] gate: {subcmd}{NC}", file=sys.stderr)
        print(f"{DIM}[mcpf-git] reason: {reason}{NC}", file=sys.stderr)
        if resp:
            for t in resp.get("triples", []):
                print(f"{DIM}[mcpf-git] triple: {t}{NC}", file=sys.stderr)

    if not allowed and not args.allow_unsafe:
        print(f"{RED}REJECTED{NC} by mcp-former: {reason}", file=sys.stderr)
        if resp and resp.get("triples"):
            for t in resp["triples"]:
                if t.get("status") == "grounded":
                    print(f"  {DIM}grounded:{NC} "
                          f"{t['s']} {t['p']} {t['o']}  "
                          f"({DIM}tier={t.get('tier','?')}){NC}",
                          file=sys.stderr)
        print(f"  {DIM}override with --allow-unsafe if you really mean it"
              f"{NC}", file=sys.stderr)
        return 2

    if args.explain:
        print(f"{GREEN}[mcpf-git] PASS{NC} → executing git "
              f"{' '.join(rest)}", file=sys.stderr)
    try:
        return subprocess.call(["git"] + rest)
    except FileNotFoundError:
        print(f"{RED}git not found on PATH.{NC}", file=sys.stderr)
        return 127


if __name__ == "__main__":
    sys.exit(main())
