#!/usr/bin/env python3
"""
mcpf wrap — produce a self-contained bundle that wraps a target piece
of software:

    bundle/
      bin/mcpf-<tool>          adapter (gate logic)
      ontologies/<tool>.nt     protection model
      mcp_server.py            MCP server that exposes the wrapped tool
      skill.md                 Anthropic-style skill description
      README.md                setup instructions

Two input modes:

    mcpf wrap <target>             use a built-in adapter (git, kubectl,
                                    gh, aws, psql)
    mcpf wrap <github-url>         clone repo, detect binary, introspect,
                                    generate stub bundle

The first mode is what we use today. The second is the "paste a URL,
get an MCP server" flow — currently best-effort: clones the repo,
tries to find a binary or entry-point, runs --help, generates a
stub adapter that you can tighten by editing.
"""
import argparse
import json
import os
import re
import shutil
import ssl
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
import zipfile
from pathlib import Path
from urllib.parse import urlparse

ROOT = Path(__file__).resolve().parent.parent
BIN = ROOT / "bin"
ONTOLOGIES = ROOT / "ontologies"
TEMPLATES = ROOT / "templates"

GREEN  = "\033[0;32m"
YELLOW = "\033[1;33m"
RED    = "\033[0;31m"
DIM    = "\033[2m"
CYAN   = "\033[0;36m"
NC     = "\033[0m"

KNOWN_TARGETS = {
    "git":     {"binary": "git",     "label": "Git"},
    "kubectl": {"binary": "kubectl", "label": "Kubernetes CLI"},
    "gh":      {"binary": "gh",      "label": "GitHub CLI"},
    "aws":     {"binary": "aws",     "label": "AWS CLI"},
    "psql":    {"binary": "psql",    "label": "PostgreSQL CLI"},
}

LLM_MODEL = "claude-haiku-4-5-20251001"
OPEN_ONTOLOGIES_BIN = os.environ.get(
    "OPEN_ONTOLOGIES_BIN",
    "/Users/fabio/projects/open-ontologies/target/release/open-ontologies")


def render(template_path, mapping):
    text = template_path.read_text()
    for k, v in mapping.items():
        text = text.replace("{{" + k + "}}", str(v))
    return text


# ----------------------------------------------------------------------
# LLM-assisted ontology generation
# ----------------------------------------------------------------------

LLM_SYSTEM = (
    "You generate protection-model ontologies in N-Triples format for "
    "the mcp-former wrapper system. Each fact follows the pattern:\n"
    "  <http://tardygrada.org/X> <http://schema.org/is_a> "
    "<http://tardygrada.org/Y> .\n"
    "Where X is a predicate name (lowercase, snake_case, no hyphens) "
    "and Y is one of:\n"
    "  destructive_op       — operations that destroy data\n"
    "                          irreversibly (delete, drop, truncate,\n"
    "                          force-push, terminate, etc.)\n"
    "  protected_resource   — specific named resources that should\n"
    "                          never be modified or deleted\n"
    "  protected_namespace  — namespaces / scopes blocked from\n"
    "                          mutation (kube-system style)\n"
    "  protected_database   — databases/datastores blocked from\n"
    "                          DROP\n"
    "  protected_role       — privileged roles whose membership\n"
    "                          should not be changed\n"
    "  protected_repo       — repos/orgs blocked from delete\n"
    "Output ONLY the N-Triples lines and # comment lines. No prose, "
    "no markdown fences. The tool's adapter will use these facts to "
    "decide whether a CLI call should be rejected. Be conservative: "
    "include flag-level destructive ops (e.g. push_force, "
    "apply_force) AND verb-level (e.g. delete, terminate) so the "
    "adapter has both granularities available."
)


def llm_generate_ontology(target, binary, help_text, readme_text):
    """Call Anthropic API to generate Turtle/N-Triples ontology.
    Returns N-Triples text or None on failure."""
    api_key = os.environ.get("ANTHROPIC_API_KEY")
    if not api_key:
        return None, "no ANTHROPIC_API_KEY in env"

    # Cap context size — README + help can be huge.
    help_text = (help_text or "")[:6000]
    readme_text = (readme_text or "")[:8000]

    user = f"""Generate a protection-model ontology for the CLI tool `{binary}`.

Tool name (for IRI subjects): {target}

--help output (truncated to 6KB):
{help_text or '(unavailable)'}

README excerpt (truncated to 8KB):
{readme_text or '(unavailable)'}

Emit N-Triples facts marking destructive operations and protected
resources. Cover both flag-level operations (e.g. push_force for
`git push --force`) and subcommand-level (delete, drop, truncate,
terminate, etc.). If the tool clearly has no destructive operations
(read-only utility), emit only a header comment."""

    body = json.dumps({
        "model": LLM_MODEL,
        "max_tokens": 2048,
        "system": LLM_SYSTEM,
        "messages": [{"role": "user", "content": user}],
    }).encode()
    req = urllib.request.Request(
        "https://api.anthropic.com/v1/messages",
        data=body,
        headers={
            "x-api-key": api_key,
            "anthropic-version": "2023-06-01",
            "content-type": "application/json",
        })
    # Same cert fallback as wikidata-ingest (macOS Python often lacks certs).
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            resp = json.loads(r.read().decode())
    except urllib.error.URLError as e:
        if isinstance(getattr(e, "reason", None), ssl.SSLError):
            ctx = ssl.create_default_context()
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
            with urllib.request.urlopen(req, timeout=60, context=ctx) as r:
                resp = json.loads(r.read().decode())
        else:
            return None, f"API error: {e}"
    except Exception as e:
        return None, f"API error: {e}"
    text = resp["content"][0]["text"]
    # Strip markdown fences if the model added any.
    text = re.sub(r"^```(?:\w+)?\s*\n|\n?```\s*$", "", text.strip(),
                  flags=re.MULTILINE)
    return text, None


def validate_ontology(text):
    """Run open-ontologies validate. Returns (ok, message). Falls back
    to a basic regex check if the binary isn't available."""
    if not Path(OPEN_ONTOLOGIES_BIN).exists():
        # Lightweight regex fallback — verify each non-comment line
        # matches the N-Triples pattern.
        line_re = re.compile(
            r'^<[^>]+>\s+<[^>]+>\s+<[^>]+>\s*\.\s*$|^\s*(#|$)')
        bad = []
        for i, line in enumerate(text.splitlines(), 1):
            if not line_re.match(line):
                bad.append(f"line {i}: {line[:80]!r}")
        if bad:
            return False, "\n".join(bad[:5])
        return True, "ok (regex-only; open-ontologies binary missing)"
    # Real validate
    try:
        with tempfile.NamedTemporaryFile(mode="w", suffix=".nt",
                                          delete=False) as tf:
            tf.write(text)
            path = tf.name
        try:
            r = subprocess.run(
                [OPEN_ONTOLOGIES_BIN, "validate", path],
                capture_output=True, text=True, timeout=20)
            if r.returncode == 0:
                return True, r.stdout.strip() or "ok"
            return False, (r.stderr.strip() or r.stdout.strip()
                            or "unknown validation error")
        finally:
            os.unlink(path)
    except Exception as e:
        return False, f"validator error: {e}"


def fetch_readme(repo_root):
    for name in ("README.md", "README.rst", "README", "readme.md", "Readme.md"):
        p = repo_root / name
        if p.exists():
            try:
                return p.read_text(encoding="utf-8", errors="replace")
            except Exception:
                pass
    return None


# ----------------------------------------------------------------------
# Mode 1: known-target bundle
# ----------------------------------------------------------------------

def gated_operations_summary(ontology_path):
    """Read the .nt file and produce a short bulleted list of
    destructive_op / protected_* facts for the skill template."""
    bullets = []
    line_re = re.compile(
        r'^<[^>]*org/(?P<s>[^>]+)>\s+<[^>]*org/(?P<p>[^>]+)>\s+'
        r'<[^>]*org/(?P<o>[^>]+)>\s*\.\s*$')
    with open(ontology_path) as f:
        for line in f:
            m = line_re.match(line.strip())
            if not m:
                continue
            s, p, o = m.group("s"), m.group("p"), m.group("o")
            if p == "is_a" and o in (
                "destructive_op", "protected_branch", "protected_namespace",
                "protected_resource", "protected_repo", "protected_database",
                "protected_schema", "protected_role", "protected_service",
            ):
                bullets.append(f"- `{s}` is_a `{o}`")
    if not bullets:
        return "(empty ontology — add facts in `ontologies/<tool>.nt`)"
    if len(bullets) > 12:
        bullets = bullets[:12] + [
            f"- … and {len(bullets) - 12} more (see ontology file)"]
    return "\n".join(bullets)


def build_known_bundle(target, out_dir):
    """Bundle the existing adapter + ontology + generated MCP server +
    skill into out_dir."""
    if target not in KNOWN_TARGETS:
        raise ValueError(f"unknown target {target}")

    info = KNOWN_TARGETS[target]
    adapter = BIN / f"mcpf-{target}"
    ontology = ONTOLOGIES / f"{target}.nt"

    if not adapter.exists():
        raise FileNotFoundError(f"adapter missing: {adapter}")
    if not ontology.exists():
        raise FileNotFoundError(f"ontology missing: {ontology}")

    out = Path(out_dir)
    (out / "bin").mkdir(parents=True, exist_ok=True)
    (out / "ontologies").mkdir(parents=True, exist_ok=True)

    shutil.copy(adapter, out / "bin" / adapter.name)
    os.chmod(out / "bin" / adapter.name, 0o755)
    shutil.copy(ontology, out / "ontologies" / ontology.name)

    mapping = {
        "TOOL_NAME": target,
        "BINARY": info["binary"],
        "GATED_OPERATIONS": gated_operations_summary(ontology),
    }
    (out / "mcp_server.py").write_text(
        render(TEMPLATES / "mcp_server.py.tmpl", mapping))
    os.chmod(out / "mcp_server.py", 0o755)
    (out / "skill.md").write_text(
        render(TEMPLATES / "skill.md.tmpl", mapping))
    (out / "README.md").write_text(
        render_readme(target, info))
    return out


def render_readme(target, info):
    return f"""# mcp-former bundle: {info['label']} ({target})

Generated by **mcp-former**. This bundle wraps `{info['binary']}` behind
a verification gate so an LLM agent can drive it without footguns.

## Layout

```
bin/mcpf-{target}          adapter — gate logic
ontologies/{target}.nt     protection model (edit to add rules)
mcp_server.py              MCP server, callable from Claude Code/Cursor
skill.md                   Anthropic-style skill description
README.md                  this file
```

## Setup

1. **Install tardygrada** (the verification engine):
   <https://github.com/fabio-rovai/tardygrada>

   ```sh
   git clone https://github.com/fabio-rovai/tardygrada
   cd tardygrada && make
   ./tardygrada daemon start
   ```

2. **Load this bundle's ontology into the daemon**:

   Either copy `ontologies/{target}.nt` to tardygrada's `tests/`
   directory and restart the daemon, or live-inject:

   ```sh
   python3 -c "
   import json, socket, re
   from pathlib import Path
   NT_RE = re.compile(r'^<[^>]*org/(?P<s>[^>]+)>\\s+<[^>]*org/(?P<p>[^>]+)>\\s+<[^>]*org/(?P<o>[^>]+)>\\s*\\.\\s*$')
   def send(p):
       s = socket.socket(socket.AF_UNIX); s.connect('/tmp/tardygrada.sock')
       s.sendall((json.dumps(p)+chr(10)).encode()); s.shutdown(socket.SHUT_WR)
       o = b''
       while True:
           d = s.recv(4096)
           if not d: break
           o += d
       return json.loads(o.decode().strip())
   for line in Path('ontologies/{target}.nt').read_text().splitlines():
       m = NT_RE.match(line.strip())
       if m:
           send({{'cmd': 'submit-fact', 'subject': m.group('s'),
                   'predicate': m.group('p'), 'object': m.group('o')}})
   "
   ```

3. **Wire the MCP server into your LLM client**:

   For Claude Code, add to `~/.config/claude/mcp.json`:

   ```json
   {{
     "mcpServers": {{
       "{target}-mcpf": {{
         "command": "python3",
         "args": ["{Path.cwd()}/mcp_server.py"]
       }}
     }}
   }}
   ```

   For Cursor / Continue / etc., consult their MCP config docs.

4. **Verify**:

   ```sh
   ./bin/mcpf-{target} --help-mcpf
   ./bin/mcpf-{target} --explain <some-args>
   ```

## CLI usage (without an LLM)

The adapter works as a drop-in replacement on the command line:

```sh
./bin/mcpf-{target} <args>          # gated
./bin/mcpf-{target} --explain <args> # show the verification trace
./bin/mcpf-{target} --allow-unsafe <args>  # bypass the gate
```

## Editing the protection model

`ontologies/{target}.nt` is the source of truth. Add a fact like:

```
<http://tardygrada.org/my_protected_thing> <http://schema.org/is_a> <http://tardygrada.org/protected_resource> .
```

Then re-inject (step 2 above) or restart the daemon. No code change.

## License

Generated bundle inherits mcp-former's license. The wrapped tool
(`{info['binary']}`) keeps its own license.
"""


# ----------------------------------------------------------------------
# Mode 2: GitHub URL bundle (best-effort)
# ----------------------------------------------------------------------

GITHUB_RE = re.compile(
    r"^https?://github\.com/([^/]+)/([^/?#]+?)(?:\.git)?/?$")


def is_github_url(s):
    return bool(GITHUB_RE.match(s))


def parse_github_url(s):
    m = GITHUB_RE.match(s)
    if not m:
        raise ValueError(f"not a GitHub URL: {s}")
    return m.group(1), m.group(2)


def _toml_section_name(text, section):
    """Find `name = "X"` inside a given TOML section. Naive but works
    for the common single-package Cargo.toml / [project] pyproject.toml
    layouts."""
    in_section = False
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("[") and s.endswith("]"):
            in_section = (s == section)
            continue
        if in_section:
            m = re.match(r'^\s*name\s*=\s*"([^"]+)"', line)
            if m:
                return m.group(1)
    return None


def detect_binary(repo_root, fallback_name):
    """Best-effort detection of the CLI binary name.
    Returns (binary, evidence_lines)."""
    evidence = []
    candidates = []

    # 1. Cargo.toml [[bin]] then [package] name
    cargo = repo_root / "Cargo.toml"
    if cargo.exists():
        text = cargo.read_text()
        bin_name = _toml_section_name(text, "[[bin]]")
        if bin_name:
            candidates.append(bin_name)
            evidence.append(f"Cargo.toml [[bin]] name={bin_name}")
        else:
            pkg_name = _toml_section_name(text, "[package]")
            if pkg_name:
                candidates.append(pkg_name)
                evidence.append(f"Cargo.toml [package] name={pkg_name}")

    # 2. package.json bin
    pkg = repo_root / "package.json"
    if pkg.exists() and not candidates:
        try:
            import json as _json
            data = _json.loads(pkg.read_text())
            bin_entry = data.get("bin")
            if isinstance(bin_entry, dict):
                k = next(iter(bin_entry.keys()))
                candidates.append(k)
                evidence.append(f"package.json bin.{k}")
            elif isinstance(bin_entry, str):
                # bin is a path; the executable name is the package name
                name = data.get("name", "")
                if name:
                    candidates.append(name)
                    evidence.append(f"package.json name={name} bin={bin_entry}")
        except Exception:
            pass

    # 3. pyproject.toml [project.scripts]
    pyp = repo_root / "pyproject.toml"
    if pyp.exists() and not candidates:
        text = pyp.read_text()
        m = re.search(r"\[project\.scripts\]\s*\n([\w-]+)\s*=", text)
        if m:
            candidates.append(m.group(1))
            evidence.append(
                f"pyproject.toml [project.scripts] {m.group(1)}")
        else:
            # fall back to [project] name
            proj_name = _toml_section_name(text, "[project]")
            if proj_name:
                candidates.append(proj_name)
                evidence.append(f"pyproject.toml [project] name={proj_name}")

    # 4. setup.py console_scripts
    setup = repo_root / "setup.py"
    if setup.exists() and not candidates:
        text = setup.read_text()
        m = re.search(r"console_scripts.*?\[\s*['\"]([\w-]+)\s*=",
                       text, re.DOTALL)
        if m:
            candidates.append(m.group(1))
            evidence.append(f"setup.py console_scripts {m.group(1)}")

    # 5. go.mod — use repo name (Go modules don't always declare bin)
    gomod = repo_root / "go.mod"
    if gomod.exists() and not candidates:
        for f in repo_root.rglob("main.go"):
            evidence.append(
                f"go.mod with main.go at {f.relative_to(repo_root)}")
            candidates.append(fallback_name)
            break

    # Final fallback: repo name from the URL (NOT the temp dir name)
    if not candidates:
        candidates.append(fallback_name)
        evidence.append(f"fallback to repo name from URL: {fallback_name}")

    return candidates[0], evidence


def discover_help(binary, repo_root):
    """Try to get --help output. Looks first for a built binary in
    common locations, then PATH."""
    candidates = [
        repo_root / binary,
        repo_root / "bin" / binary,
        repo_root / "build" / binary,
        repo_root / "target" / "release" / binary,
        repo_root / "target" / "debug" / binary,
    ]
    for c in candidates:
        if c.exists() and os.access(c, os.X_OK):
            try:
                r = subprocess.run([str(c), "--help"],
                                    capture_output=True, text=True,
                                    timeout=5)
                return r.stdout or r.stderr, str(c)
            except Exception:
                pass
    # Fallback to PATH
    if shutil.which(binary):
        try:
            r = subprocess.run([binary, "--help"],
                                capture_output=True, text=True, timeout=5)
            return r.stdout or r.stderr, binary
        except Exception:
            pass
    return None, None


def build_repo_bundle(url, out_dir, use_llm=False):
    owner, repo = parse_github_url(url)
    print(f"{DIM}cloning {owner}/{repo}…{NC}")
    work = Path(tempfile.mkdtemp(prefix="mcpf-wrap-"))
    clone_dir = work / "src"
    try:
        subprocess.run(
            ["git", "clone", "--depth=1", url, str(clone_dir)],
            capture_output=True, check=True, timeout=120)
    except subprocess.CalledProcessError as e:
        raise RuntimeError(f"clone failed: {e.stderr.decode()}")

    binary, evidence = detect_binary(clone_dir, fallback_name=repo)
    print(f"{DIM}detected binary: {CYAN}{binary}{NC}")
    for line in evidence:
        print(f"  {DIM}↳ {line}{NC}")

    help_text, help_source = discover_help(binary, clone_dir)
    if help_text:
        print(f"{DIM}got --help from {help_source} "
              f"({len(help_text)} bytes){NC}")
    else:
        print(f"{YELLOW}no --help output available{NC}")

    readme_text = fetch_readme(clone_dir)
    if readme_text:
        print(f"{DIM}got README ({len(readme_text)} bytes){NC}")

    out = Path(out_dir)
    (out / "bin").mkdir(parents=True, exist_ok=True)
    (out / "ontologies").mkdir(parents=True, exist_ok=True)
    target = re.sub(r"[^a-zA-Z0-9_]", "_", binary)
    onto_path = out / "ontologies" / f"{target}.nt"

    # ---- Ontology generation: LLM if requested+available, else stub ----
    onto_source = "stub"
    if use_llm:
        print(f"{DIM}generating ontology via {LLM_MODEL}…{NC}")
        nt_text, err = llm_generate_ontology(
            target, binary, help_text, readme_text)
        if nt_text:
            ok, msg = validate_ontology(nt_text)
            if ok:
                # Wrap with provenance header
                onto_path.write_text(
                    f"# Auto-generated by mcpf-wrap from {url}\n"
                    f"# Binary: {binary}\n"
                    f"# Source: LLM ({LLM_MODEL})\n"
                    f"# Validator: {msg}\n"
                    f"# Review and tighten before production use.\n\n"
                    f"{nt_text}\n")
                onto_source = "llm"
                fact_count = sum(
                    1 for line in nt_text.splitlines()
                    if line.strip().startswith("<"))
                print(f"  {GREEN}✓ generated {fact_count} facts, "
                      f"validated{NC}")
            else:
                print(f"  {YELLOW}LLM output failed validation: "
                      f"{msg}{NC}")
                print(f"  {DIM}falling back to stub ontology{NC}")
        else:
            print(f"  {YELLOW}LLM unavailable: {err}{NC}")
            print(f"  {DIM}falling back to stub ontology{NC}")

    if onto_source == "stub":
        onto_path.write_text(f"""# Auto-generated by mcpf-wrap from {url}
# Binary: {binary}
# Help text: {len(help_text or '')} bytes
#
# This is a STUB. Add real protection facts here based on your
# knowledge of {binary}'s destructive operations. See
# ontologies/git.nt or ontologies/kubectl.nt in mcp-former for
# reference patterns. Or re-run with --llm to auto-generate.

# Example: mark a destructive operation
# <http://tardygrada.org/some_destructive_op> <http://schema.org/is_a> <http://tardygrada.org/destructive_op> .
""")

    # Stub adapter — passes everything through with --explain logging
    stub_adapter = out / "bin" / f"mcpf-{target}"
    stub_adapter.write_text(f"""#!/usr/bin/env python3
\"\"\"Auto-generated stub wrapper for {binary}.

This adapter currently passes everything through. Edit gate_default()
below to add real protection logic, mirroring mcpf-git or mcpf-kubectl
in mcp-former's bin/.
\"\"\"
import sys, subprocess

BINARY = "{binary}"

def main():
    args = sys.argv[1:]
    # TODO: add gate logic — claim_grounded against tardygrada
    try:
        return subprocess.call([BINARY] + args)
    except FileNotFoundError:
        print(f"{{BINARY}} not found on PATH.", file=sys.stderr)
        return 127

if __name__ == "__main__":
    sys.exit(main())
""")
    os.chmod(stub_adapter, 0o755)

    # Render server + skill from templates with the discovered binary
    mapping = {
        "TOOL_NAME": target,
        "BINARY": binary,
        "GATED_OPERATIONS": ("(stub ontology — edit "
                              f"`ontologies/{target}.nt` to add real "
                              "protection rules)"),
    }
    (out / "mcp_server.py").write_text(
        render(TEMPLATES / "mcp_server.py.tmpl", mapping))
    os.chmod(out / "mcp_server.py", 0o755)
    (out / "skill.md").write_text(
        render(TEMPLATES / "skill.md.tmpl", mapping))

    # Stub README
    (out / "README.md").write_text(f"""# mcp-former stub bundle: {owner}/{repo}

Generated by `mcpf wrap {url}`.

This is a **stub bundle** — the introspector cloned the repo and
detected `{binary}` as the binary, but didn't generate real protection
rules. You'll need to:

1. Edit `ontologies/{target}.nt` to add facts about which operations
   are destructive (DROP, DELETE, FORCE, TERMINATE, etc.).
2. Edit `bin/mcpf-{target}` to gate those operations against the
   ontology, mirroring mcp-former's other adapters.

See `templates/` and `bin/mcpf-git` in mcp-former for patterns.

Detection evidence:

""" + "\n".join(f"- {e}" for e in evidence) + (f"""

Help-text source: `{help_source}` ({len(help_text)} bytes)
""" if help_text else "\nNo --help output available.\n"))

    shutil.rmtree(work, ignore_errors=True)
    return out


# ----------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("target",
        help=f"built-in target ({', '.join(KNOWN_TARGETS)}) or a "
             f"GitHub URL")
    ap.add_argument("--out", default=None,
        help="output directory (default: ./mcp-former-<target>)")
    ap.add_argument("--zip", action="store_true",
        help="also produce a .zip alongside the directory")
    ap.add_argument("--llm", action="store_true",
        help="when wrapping a GitHub URL, use the Anthropic API to "
             "generate the ontology (needs ANTHROPIC_API_KEY); "
             "validates output via open-ontologies")
    args = ap.parse_args()

    if is_github_url(args.target):
        owner, repo = parse_github_url(args.target)
        out_name = f"mcp-former-{owner}-{repo}"
        out_dir = args.out or out_name
        print(f"{DIM}mode: github URL → repo bundle "
              f"({'LLM' if args.llm else 'stub'}){NC}")
        out = build_repo_bundle(args.target, out_dir, use_llm=args.llm)
    elif args.target in KNOWN_TARGETS:
        out_name = f"mcp-former-{args.target}"
        out_dir = args.out or out_name
        print(f"{DIM}mode: known target → bundle{NC}")
        out = build_known_bundle(args.target, out_dir)
    else:
        print(f"{RED}unknown target{NC}: {args.target}", file=sys.stderr)
        print(f"  built-in: {', '.join(KNOWN_TARGETS)}", file=sys.stderr)
        print(f"  or paste a GitHub URL", file=sys.stderr)
        return 2

    print(f"{GREEN}✓ wrote bundle to {out}{NC}")
    if args.zip:
        zip_path = Path(str(out) + ".zip")
        with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as zf:
            for p in out.rglob("*"):
                if p.is_file():
                    zf.write(p, p.relative_to(out.parent))
        print(f"{GREEN}✓ wrote zip to {zip_path}{NC}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
