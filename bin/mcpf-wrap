#!/usr/bin/env python3
"""
mcpf wrap — produce a self-contained bundle that wraps a target piece
of software:

    bundle/
      bin/mcpf-<tool>          adapter (gate logic)
      ontologies/<tool>.nt     protection model
      mcp_server.py            MCP server that exposes the wrapped tool
      skill.md                 Anthropic-style skill description
      README.md                setup instructions

Two input modes:

    mcpf wrap <target>             use a built-in adapter (git, kubectl,
                                    gh, aws, psql)
    mcpf wrap <github-url>         clone repo, detect binary, introspect,
                                    generate stub bundle

The first mode is what we use today. The second is the "paste a URL,
get an MCP server" flow — currently best-effort: clones the repo,
tries to find a binary or entry-point, runs --help, generates a
stub adapter that you can tighten by editing.
"""
import argparse
import json
import os
import re
import shutil
import ssl
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
import zipfile
from pathlib import Path
from urllib.parse import urlparse

ROOT = Path(__file__).resolve().parent.parent
BIN = ROOT / "bin"
ONTOLOGIES = ROOT / "ontologies"
TEMPLATES = ROOT / "templates"

GREEN  = "\033[0;32m"
YELLOW = "\033[1;33m"
RED    = "\033[0;31m"
DIM    = "\033[2m"
CYAN   = "\033[0;36m"
NC     = "\033[0m"

KNOWN_TARGETS = {
    "git":     {"binary": "git",     "label": "Git"},
    "kubectl": {"binary": "kubectl", "label": "Kubernetes CLI"},
    "gh":      {"binary": "gh",      "label": "GitHub CLI"},
    "aws":     {"binary": "aws",     "label": "AWS CLI"},
    "psql":    {"binary": "psql",    "label": "PostgreSQL CLI"},
}

LLM_MODEL = "claude-haiku-4-5-20251001"
OPEN_ONTOLOGIES_BIN = os.environ.get(
    "OPEN_ONTOLOGIES_BIN",
    "/Users/fabio/projects/open-ontologies/target/release/open-ontologies")


# ----------------------------------------------------------------------
# Generic ontology-driven adapter — emitted by URL-mode wrap.
# Same gate logic for every wrapped tool: parse args → identify verb
# (first non-flag arg) → query "VERB is a destructive_op" against the
# running tardygrada daemon → check positional args against
# `protected_thing` → reject or execute. The protection model lives
# entirely in the per-tool ontology, not in code.
# ----------------------------------------------------------------------

GENERIC_ADAPTER_TEMPLATE = '''#!/usr/bin/env python3
"""
mcpf-{target}: auto-generated wrapper around the {binary} CLI.

Generic ontology-driven gate. The protection model lives in
../ontologies/{target}.nt and is loaded into the running tardygrada
daemon. No tool-specific parsing — the adapter asks the ontology.
"""
import argparse
import json
import os
import re
import socket
import subprocess
import sys

SOCK = "/tmp/tardygrada.sock"
BINARY = "{binary}"

GREEN  = "\\033[0;32m"
YELLOW = "\\033[1;33m"
RED    = "\\033[0;31m"
DIM    = "\\033[2m"
NC     = "\\033[0m"


def daemon_query(claim):
    if not os.path.exists(SOCK):
        return None
    try:
        s = socket.socket(socket.AF_UNIX); s.connect(SOCK)
        s.sendall((json.dumps({{"cmd": "run", "claim": claim}}) + "\\n").encode())
        s.shutdown(socket.SHUT_WR)
        buf = b""
        while True:
            chunk = s.recv(4096)
            if not chunk: break
            buf += chunk
        s.close()
        return json.loads(buf.decode().strip())
    except Exception:
        return None


def claim_grounded(claim):
    """True if the daemon says VERIFIED with a grounded triple."""
    resp = daemon_query(claim)
    if not resp or resp.get("result") != "VERIFIED":
        return False, resp
    for t in resp.get("triples", []):
        if t.get("status") == "grounded":
            return True, resp
    return False, resp


def normalize(s):
    """Convert hyphens/dots/etc. to underscores so CLI tokens match
    the snake_case form used in the ontology."""
    return re.sub(r"[^a-zA-Z0-9_]", "_", s)


def gate(args):
    """Generic ontology-driven gate. Returns (allowed, reason, response)."""
    if not args:
        return True, "no args", None

    # 1. Identify the verb — first non-flag positional. For tools with
    #    noun-verb dispatch (gh repo delete) we also try noun_verb.
    nonflag = [a for a in args if not a.startswith("-")]
    if not nonflag:
        return True, "no positional args", None

    verb = normalize(nonflag[0])
    pair_verb = (normalize(nonflag[0]) + "_" + normalize(nonflag[1])
                  if len(nonflag) >= 2 else None)

    # 2. Operation-level check: is this verb a destructive_op?
    #    Try several candidate names so we match whichever convention
    #    the ontology uses:
    #      verb                   ("delete")
    #      <binary>_verb          ("rclone_delete")
    #      <noun>_<verb>          ("repo_delete")
    binary_norm = normalize(BINARY)
    for op_candidate in (verb,
                         f"{{binary_norm}}_{{verb}}",
                         pair_verb):
        if not op_candidate:
            continue
        ok, resp = claim_grounded(f"{{op_candidate}} is a destructive_op")
        if ok:
            return False, f"{{op_candidate}} is a destructive_op", resp

    # 3. Flag-level check: combinations like <verb>_<flag>,
    #    <binary>_<flag>, <verb>_flag_<flag>.
    for a in args:
        if not a.startswith("--"):
            continue
        flag = normalize(a.lstrip("-"))
        for op in (f"{{verb}}_{{flag}}",
                   f"{{binary_norm}}_{{flag}}",
                   f"{{binary_norm}}_flag_{{flag}}"):
            ok, resp = claim_grounded(f"{{op}} is a destructive_op")
            if ok:
                return False, f"{{verb}} {{a}} is a destructive_op", resp

    # 4. Target-level check: are any positional args known
    #    protected_things?
    for tgt in nonflag[1:]:
        for token in (tgt, normalize(tgt)):
            ok, resp = claim_grounded(f"{{token}} is a protected_thing")
            if ok:
                return False, f"{{tgt}} is a protected_thing", resp

    return True, f"no protection match for {{verb}}", None


def main():
    ap = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
    ap.add_argument("--explain", action="store_true")
    ap.add_argument("--allow-unsafe", action="store_true")
    ap.add_argument("--help-mcpf", action="store_true")
    args, rest = ap.parse_known_args()

    if args.help_mcpf or not rest:
        print(__doc__)
        return 0

    allowed, reason, resp = gate(rest)

    if args.explain:
        print(f"{{DIM}}[mcpf-{target}] reason: {{reason}}{{NC}}", file=sys.stderr)
        if resp:
            for t in resp.get("triples", []):
                print(f"{{DIM}}[mcpf-{target}] triple: {{t}}{{NC}}",
                      file=sys.stderr)

    if not allowed and not args.allow_unsafe:
        print(f"{{RED}}REJECTED{{NC}} by mcp-former: {{reason}}",
              file=sys.stderr)
        if resp and resp.get("triples"):
            for t in resp["triples"]:
                if t.get("status") == "grounded":
                    print(f"  {{DIM}}grounded:{{NC}} "
                          f"{{t['s']}} {{t['p']}} {{t['o']}}  "
                          f"({{DIM}}tier={{t.get('tier','?')}}){{NC}}",
                          file=sys.stderr)
        print(f"  {{DIM}}override with --allow-unsafe if you really mean it"
              f"{{NC}}", file=sys.stderr)
        return 2

    if args.explain:
        print(f"{{GREEN}}[mcpf-{target}] PASS{{NC}} → executing {{BINARY}} "
              f"{{' '.join(rest)}}", file=sys.stderr)
    try:
        return subprocess.call([BINARY] + rest)
    except FileNotFoundError:
        print(f"{{RED}}{{BINARY}} not found on PATH.{{NC}}",
              file=sys.stderr)
        return 127


if __name__ == "__main__":
    sys.exit(main())
'''


def render(template_path, mapping):
    text = template_path.read_text()
    for k, v in mapping.items():
        text = text.replace("{{" + k + "}}", str(v))
    return text


# ----------------------------------------------------------------------
# LLM-assisted ontology generation
# ----------------------------------------------------------------------

LLM_SYSTEM = (
    "You generate protection-model ontologies in N-Triples format for "
    "the mcp-former wrapper system. Each fact follows the pattern:\n"
    "  <http://tardygrada.org/X> <http://schema.org/is_a> "
    "<http://tardygrada.org/Y> .\n"
    "Where X is a predicate name (lowercase, snake_case, no hyphens) "
    "and Y is one of:\n"
    "  destructive_op       — operations that destroy data\n"
    "                          irreversibly (delete, drop, truncate,\n"
    "                          force-push, terminate, etc.)\n"
    "  protected_resource   — specific named resources that should\n"
    "                          never be modified or deleted\n"
    "  protected_namespace  — namespaces / scopes blocked from\n"
    "                          mutation (kube-system style)\n"
    "  protected_database   — databases/datastores blocked from\n"
    "                          DROP\n"
    "  protected_role       — privileged roles whose membership\n"
    "                          should not be changed\n"
    "  protected_repo       — repos/orgs blocked from delete\n"
    "Output ONLY the N-Triples lines and # comment lines. No prose, "
    "no markdown fences. The tool's adapter will use these facts to "
    "decide whether a CLI call should be rejected. Be conservative: "
    "include flag-level destructive ops (e.g. push_force, "
    "apply_force) AND verb-level (e.g. delete, terminate) so the "
    "adapter has both granularities available."
)


def _build_user_prompt(target, binary, help_text, readme_text,
                         surface_text=None):
    help_text = (help_text or "")[:6000]
    readme_text = (readme_text or "")[:8000]
    surface_text = (surface_text or "")[:6000]

    # The extracted surface (cobra/clap/click definitions from source)
    # is treated as MORE AUTHORITATIVE than the README, since READMEs
    # often skip undocumented commands or use marketing language.
    sources = []
    if surface_text:
        sources.append(
            "AUTHORITATIVE — extracted directly from CLI framework "
            "definitions in source code (cobra/clap/click/commander). "
            "Treat this as the ground truth for the tool's surface "
            "area:\n\n" + surface_text)
    if help_text:
        sources.append(f"--help output (truncated to 6KB):\n{help_text}")
    if readme_text:
        sources.append(
            f"README excerpt — descriptive only, may be incomplete or "
            f"out of date (truncated to 8KB):\n{readme_text}")

    if not sources:
        sources.append("(no source material available)")

    return f"""Generate a protection-model ontology for the CLI tool `{binary}`.

Tool name (for IRI subjects): {target}

{chr(10).join(f'### Source {i+1}{chr(10)}{s}' for i, s in enumerate(sources))}

Emit N-Triples facts marking destructive operations and protected
resources. Cover both flag-level operations (e.g. push_force for
`git push --force`) and subcommand-level (delete, drop, truncate,
terminate, etc.). Prefer source-extracted subcommand names over
README descriptions when they conflict. If the tool clearly has no
destructive operations (read-only utility), emit only a header
comment."""


def _strip_fences(text):
    return re.sub(
        r"^```(?:\w+)?\s*\n|\n?```\s*$", "", text.strip(),
        flags=re.MULTILINE)


def _generate_via_api(target, binary, help_text, readme_text,
                        surface_text=None):
    """Call Anthropic API directly. Needs ANTHROPIC_API_KEY."""
    api_key = os.environ.get("ANTHROPIC_API_KEY")
    if not api_key:
        return None, "no ANTHROPIC_API_KEY in env"
    user = _build_user_prompt(target, binary, help_text, readme_text,
                                surface_text)
    body = json.dumps({
        "model": LLM_MODEL,
        "max_tokens": 2048,
        "system": LLM_SYSTEM,
        "messages": [{"role": "user", "content": user}],
    }).encode()
    req = urllib.request.Request(
        "https://api.anthropic.com/v1/messages",
        data=body,
        headers={
            "x-api-key": api_key,
            "anthropic-version": "2023-06-01",
            "content-type": "application/json",
        })
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            resp = json.loads(r.read().decode())
    except urllib.error.URLError as e:
        if isinstance(getattr(e, "reason", None), ssl.SSLError):
            ctx = ssl.create_default_context()
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
            with urllib.request.urlopen(req, timeout=60, context=ctx) as r:
                resp = json.loads(r.read().decode())
        else:
            return None, f"API error: {e}"
    except Exception as e:
        return None, f"API error: {e}"
    return _strip_fences(resp["content"][0]["text"]), None


def _generate_via_claude_cli(target, binary, help_text, readme_text,
                                surface_text=None):
    """Shell out to `claude -p` — uses the user's existing Claude Code
    session, no API key needed. The prompt goes via stdin to avoid
    flag-parsing collisions on long multi-line content."""
    if not shutil.which("claude"):
        return None, "claude CLI not on PATH"
    user = _build_user_prompt(target, binary, help_text, readme_text,
                                surface_text)
    cmd = [
        "claude", "-p",
        "--output-format", "text",
        "--append-system-prompt", LLM_SYSTEM,
        "--disallowedTools", "Bash,Edit,Write,WebSearch,WebFetch",
    ]
    try:
        r = subprocess.run(
            cmd, input=user, capture_output=True, text=True, timeout=180)
    except subprocess.TimeoutExpired:
        return None, "claude CLI timed out"
    except Exception as e:
        return None, f"claude CLI error: {e}"
    if r.returncode != 0:
        err = r.stderr.strip() or r.stdout.strip() or "non-zero exit"
        return None, f"claude CLI error: {err[:200]}"
    return _strip_fences(r.stdout), None


def llm_generate_ontology(target, binary, help_text, readme_text,
                            backend="auto", surface_text=None):
    """Generate ontology via the chosen backend.
       backend in {auto, api, claude-cli}.
       'auto': try API if key set, else claude CLI, else fail."""
    if backend == "api":
        return _generate_via_api(target, binary, help_text, readme_text,
                                    surface_text)
    if backend == "claude-cli":
        return _generate_via_claude_cli(target, binary, help_text,
                                          readme_text, surface_text)
    # auto
    if os.environ.get("ANTHROPIC_API_KEY"):
        return _generate_via_api(target, binary, help_text, readme_text,
                                    surface_text)
    if shutil.which("claude"):
        return _generate_via_claude_cli(target, binary, help_text,
                                          readme_text, surface_text)
    return None, "no LLM backend available (set ANTHROPIC_API_KEY or install claude CLI)"


def validate_ontology(text):
    """Run open-ontologies validate. Returns (ok, message). Falls back
    to a basic regex check if the binary isn't available."""
    if not Path(OPEN_ONTOLOGIES_BIN).exists():
        # Lightweight regex fallback — verify each non-comment line
        # matches the N-Triples pattern.
        line_re = re.compile(
            r'^<[^>]+>\s+<[^>]+>\s+<[^>]+>\s*\.\s*$|^\s*(#|$)')
        bad = []
        for i, line in enumerate(text.splitlines(), 1):
            if not line_re.match(line):
                bad.append(f"line {i}: {line[:80]!r}")
        if bad:
            return False, "\n".join(bad[:5])
        return True, "ok (regex-only; open-ontologies binary missing)"
    # Real validate
    try:
        with tempfile.NamedTemporaryFile(mode="w", suffix=".nt",
                                          delete=False) as tf:
            tf.write(text)
            path = tf.name
        try:
            r = subprocess.run(
                [OPEN_ONTOLOGIES_BIN, "validate", path],
                capture_output=True, text=True, timeout=20)
            if r.returncode == 0:
                return True, r.stdout.strip() or "ok"
            return False, (r.stderr.strip() or r.stdout.strip()
                            or "unknown validation error")
        finally:
            os.unlink(path)
    except Exception as e:
        return False, f"validator error: {e}"


def submit_bundle_ontology_to_daemon(bundle_dir):
    """Push the bundle's ontology facts to the running tardygrada
    daemon so the wrap-time audit can ground against them. Without
    this, audit ALWAYS fails grounding for fresh bundles. Skipped
    silently if the daemon isn't running."""
    sock = "/tmp/tardygrada.sock"
    if not os.path.exists(sock):
        return None, "tardygrada daemon not running"
    nt_files = list((bundle_dir / "ontologies").glob("*.nt"))
    if not nt_files:
        return None, "no .nt file in bundle"

    import socket as _sock
    NT = re.compile(
        r'^<[^>]*org/(?P<s>[^>]+)>\s+<[^>]*org/(?P<p>[^>]+)>\s+'
        r'<[^>]*org/(?P<o>[^>]+)>\s*\.\s*$')
    counts = {"accepted": 0, "duplicate": 0, "other": 0}
    for nt_path in nt_files:
        for line in nt_path.read_text().splitlines():
            m = NT.match(line.strip())
            if not m:
                continue
            try:
                s = _sock.socket(_sock.AF_UNIX); s.connect(sock)
                s.sendall((json.dumps({
                    "cmd": "submit-fact",
                    "subject": m.group("s"),
                    "predicate": m.group("p"),
                    "object": m.group("o"),
                }) + "\n").encode())
                s.shutdown(_sock.SHUT_WR)
                buf = b""
                while True:
                    chunk = s.recv(4096)
                    if not chunk: break
                    buf += chunk
                s.close()
                resp = json.loads(buf.decode().strip())
                st = resp.get("status", "other")
                counts[st] = counts.get(st, 0) + 1
            except Exception:
                counts["other"] += 1
    return counts, None


def run_audit_and_save(bundle_dir):
    """Shell out to mcpf-audit on the freshly-wrapped bundle and save
    the JSON output as bundle/AUDIT.md. Doesn't fail the wrap on audit
    failures — just records them in the bundle so the user knows."""
    audit_bin = Path(__file__).resolve().parent / "mcpf-audit"
    if not audit_bin.exists():
        return
    print(f"{DIM}auditing bundle…{NC}")
    try:
        r = subprocess.run(
            [str(audit_bin), str(bundle_dir), "--json",
             "--no-existence", "--no-coverage"],
            capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        print(f"  {YELLOW}audit timed out{NC}")
        return
    if not r.stdout:
        return
    try:
        data = json.loads(r.stdout)
    except Exception:
        return

    # Render an AUDIT.md that captures the bundle's conformance
    md = ["# Audit report",
          "",
          f"Generated by `mcpf audit` at wrap time.",
          ""]
    if data.get("ok"):
        md.append("**Status: PASS**")
    else:
        md.append("**Status: FAIL** "
                   f"({len(data.get('failed', []))} failed checks)")
    md.append("")
    md.append(f"- Binary: `{data.get('binary')}`")
    md.append(f"- Ontology: `{data.get('ontology')}`")
    md.append(f"- Fact count: {data.get('fact_count')}")
    md.append("")
    md.append("## Tests")
    md.append("")
    md.append("| Test | Result | Detail |")
    md.append("| ---- | ------ | ------ |")
    for it in data.get("passed", []):
        md.append(f"| {it['name']} | ✓ pass | {it['detail']} |")
    for it in data.get("failed", []):
        md.append(f"| {it['name']} | ✗ fail | {it['detail']} |")
    for it in data.get("skipped", []):
        md.append(f"| {it['name']} | – skip | {it['reason']} |")
    md.append("")
    md.append("## Re-run")
    md.append("")
    md.append("```sh")
    md.append(f"mcpf audit {bundle_dir}")
    md.append(f"mcpf audit {bundle_dir} -v        # verbose")
    md.append(f"mcpf audit {bundle_dir} --json    # machine output")
    md.append("```")
    md.append("")
    md.append("To run existence + coverage checks (need the binary "
              "on PATH):")
    md.append("")
    md.append("```sh")
    md.append(f"mcpf audit {bundle_dir} -v")
    md.append("```")

    (bundle_dir / "AUDIT.md").write_text("\n".join(md) + "\n")

    if data.get("ok"):
        print(f"  {GREEN}✓ audit PASS — {len(data.get('passed', []))} "
              f"checks, see AUDIT.md{NC}")
    else:
        print(f"  {YELLOW}✗ audit FAIL — "
              f"{len(data.get('failed', []))} checks failed, "
              f"see AUDIT.md{NC}")


def fetch_readme(repo_root):
    for name in ("README.md", "README.rst", "README", "readme.md", "Readme.md"):
        p = repo_root / name
        if p.exists():
            try:
                return p.read_text(encoding="utf-8", errors="replace")
            except Exception:
                pass
    return None


# ----------------------------------------------------------------------
# Source-level CLI surface extraction.
#
# README is marketing copy in many repos — it skips undocumented
# commands, uses outdated examples, and hides destructive operations
# behind euphemisms. The CLI definition framework is more factual:
# every Go binary using cobra has `cobra.Command{Use: "delete", ...}`
# entries; every Rust binary using clap has `Command::new("delete")`;
# every Python click has `@click.command(name="delete")`. Grepping
# these patterns gives us the actual surface area, not what the
# author wished it looked like.
# ----------------------------------------------------------------------

# Cobra: `Use:` field appears anywhere in the codebase. Simple pattern
# wins over trying to parse the whole struct literal — false positives
# are filtered later by length and exclusion list.
GO_COBRA_USE_RE = re.compile(
    r'^\s*Use:\s*"([a-zA-Z][\w-]+)"', re.MULTILINE)
GO_COBRA_SHORT_RE = re.compile(
    r'^\s*Short:\s*"([^"]+)"', re.MULTILINE)

# Cobra-wrapper helpers — many projects (flyctl, cilium-cli, kubectl
# subprojects) wrap cobra in a `command.New(usage, short, long, run)`
# helper. The first positional arg is the usage line; the first word
# is the subcommand name. Possibly preceded by `<receiver>.` so we
# match `*.New(`, `*.NewCommand(`, `*.NewCmd(`, etc.
GO_COBRA_HELPER_RE = re.compile(
    r'(?:[a-zA-Z_][\w]*\.)?(?:New|NewCommand|NewCmd|NewSubCommand)\(\s*'
    r'"([a-zA-Z][\w-]*)(?:\s+[<\[][^"]*)?"', re.MULTILINE)

# mitchellh/cli — used by terraform, packer, vault. Pattern:
#   "destroy": func() (cli.Command, error) { return &DestroyCommand{...
GO_MITCHELLH_RE = re.compile(
    r'^\s*"([a-z][\w-]+)":\s*func\(\)\s*\(cli\.Command,\s*error\)',
    re.MULTILINE)

# urfave/cli — used by docker, syncthing, drone. Pattern:
#   {Name: "delete", ...}  inside cli.Command struct
GO_URFAVE_RE = re.compile(
    r'^\s*Name:\s*"([a-zA-Z][\w-]+)"', re.MULTILINE)

RUST_CLAP_RE = re.compile(
    r'(?:Command::new\(\s*"([a-zA-Z][\w-]*)"|'
    r'(?:SubCommand::with_name|App::new)\(\s*"([a-zA-Z][\w-]*)"|'
    r'#\[command\([^)]*name\s*=\s*"([a-zA-Z][\w-]*)")')

PY_CLICK_RE = re.compile(
    r'@(?:click|app)\.(?:command|group)\(\s*(?:name\s*=\s*)?["\']'
    r'([a-zA-Z][\w-]*)["\']')

# Generic argparse subparser: ap.add_parser("delete", ...)
PY_ARGPARSE_RE = re.compile(
    r'(?:add_parser|add_subparser)\(\s*["\']'
    r'([a-zA-Z][\w-]*)["\']')

NODE_COMMANDER_RE = re.compile(
    r'\.command\(\s*["\']([a-zA-Z][\w-]*(?:\s+[<\[][^"\']+)?)["\']')

# Filter out common false positives from generic Use:/Short: matches
COBRA_FALSE_POSITIVES = {
    "use", "TestMain", "main", "init", "run",
    # Test fixture names
    "test", "example",
}


def extract_surface(repo_root):
    """Walk the repo, looking for CLI definition patterns. Returns
    a dict mapping framework → list of subcommand names + a short
    extracted description if available."""
    found = {}

    # Cap size: don't scan repos bigger than 10k files (huge monorepos
    # would tank performance) and skip obvious non-source dirs.
    SKIP_DIRS = {".git", "node_modules", "vendor", "target", "dist",
                 "build", "__pycache__", ".venv", "venv", "out"}
    SCAN_EXTS = {".go", ".rs", ".py", ".js", ".ts"}

    file_count = 0
    for root, dirs, files in os.walk(repo_root):
        # Prune skip dirs
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
        for fname in files:
            if file_count > 5000:
                break
            ext = os.path.splitext(fname)[1]
            if ext not in SCAN_EXTS:
                continue
            file_count += 1
            path = os.path.join(root, fname)
            try:
                with open(path, "r", encoding="utf-8",
                          errors="replace") as f:
                    text = f.read()
            except Exception:
                continue

            if ext == ".go":
                # Skip test files — fixtures inflate the surface
                if fname.endswith("_test.go"):
                    continue
                short_matches = list(GO_COBRA_SHORT_RE.finditer(text))

                def find_short(start_pos):
                    for sm in short_matches:
                        if 0 < sm.start() - start_pos < 600:
                            return sm.group(1)[:120]
                    return ""

                # Cobra: pair Use: with neighbouring Short: line
                for um in GO_COBRA_USE_RE.finditer(text):
                    name = um.group(1).split()[0]
                    if name in COBRA_FALSE_POSITIVES:
                        continue
                    found.setdefault("cobra", []).append(
                        (name, find_short(um.start())))

                # Cobra-wrapper helpers — `command.New("usage <args>", ...)`
                for hm in GO_COBRA_HELPER_RE.finditer(text):
                    name = hm.group(1).split()[0]
                    if name in COBRA_FALSE_POSITIVES:
                        continue
                    # Heuristic: only count when the call is on its own
                    # line or assigned (avoid false matches in tests/
                    # docs blocks). A weak signal: previous 2 chars are
                    # one of `=`, `:=`, `,`, `(`, `\n`, ` `.
                    found.setdefault("cobra", []).append(
                        (name, find_short(hm.start())))

                # mitchellh/cli (terraform, vault, packer)
                for m in GO_MITCHELLH_RE.finditer(text):
                    found.setdefault("mitchellh-cli", []).append(
                        (m.group(1), ""))

                # urfave/cli (docker, syncthing) — Name: in a Command
                # struct, but only count when likely-CLI context.
                # Cheap heuristic: file references "urfave/cli" or
                # "github.com/urfave".
                if ("urfave/cli" in text or "urfave\\/cli" in text):
                    for m in GO_URFAVE_RE.finditer(text):
                        name = m.group(1)
                        if name in COBRA_FALSE_POSITIVES:
                            continue
                        found.setdefault("urfave-cli", []).append(
                            (name, find_short(m.start())))
            elif ext == ".rs":
                for m in RUST_CLAP_RE.finditer(text):
                    name = m.group(1) or m.group(2) or m.group(3)
                    if name:
                        found.setdefault("clap", []).append((name, ""))
            elif ext == ".py":
                for m in PY_CLICK_RE.finditer(text):
                    found.setdefault("click", []).append((m.group(1), ""))
                for m in PY_ARGPARSE_RE.finditer(text):
                    cmd = m.group(1)
                    if not cmd.startswith("--"):
                        found.setdefault("argparse", []).append(
                            (cmd, ""))
            elif ext in (".js", ".ts"):
                for m in NODE_COMMANDER_RE.finditer(text):
                    found.setdefault("commander", []).append(
                        (m.group(1).split()[0], ""))

    # Dedup per framework, preserve first description seen
    cleaned = {}
    for fw, entries in found.items():
        seen = {}
        for name, desc in entries:
            if name not in seen or (desc and not seen[name]):
                seen[name] = desc
        cleaned[fw] = sorted(seen.items())
    return cleaned


def render_surface(surface, max_per_framework=80):
    """Format the extracted surface for the LLM prompt."""
    if not surface:
        return None
    out = []
    for fw, entries in surface.items():
        out.append(f"## CLI surface ({fw}, {len(entries)} subcommands)")
        for name, desc in entries[:max_per_framework]:
            if desc:
                out.append(f"  {name:24s}  {desc}")
            else:
                out.append(f"  {name}")
        if len(entries) > max_per_framework:
            out.append(f"  … and {len(entries) - max_per_framework} more")
    return "\n".join(out)


# ----------------------------------------------------------------------
# Mode 1: known-target bundle
# ----------------------------------------------------------------------

def _example_args(ontology_path, binary):
    """Pick 2 destructive ops from the ontology and render them as
    realistic args-list examples for the skill. Tool-specific so the
    LLM sees `["apps", "destroy", "myapp"]`, not `["branch", "-D",
    "main"]` for flyctl."""
    line_re = re.compile(
        r'^<[^>]*org/(?P<s>[^>]+)>\s+<[^>]*org/is_a>\s+'
        r'<[^>]*org/destructive_op>\s*\.\s*$')
    candidates = []
    if not Path(ontology_path).exists():
        return ""
    with open(ontology_path) as f:
        for line in f:
            m = line_re.match(line.strip())
            if m:
                candidates.append(m.group("s"))
            if len(candidates) >= 4:
                break
    if not candidates:
        return ""
    # Render as `args: [...]` lines. Ops named `<binary>_<verb>` →
    # ["verb", ...]. Ops named `<noun>_<verb>` → ["noun", "verb", ...].
    out_lines = []
    for op in candidates[:2]:
        op_clean = op.replace(f"{binary}_", "", 1) if op.startswith(
            f"{binary}_") else op
        parts = op_clean.split("_")
        arg_str = ", ".join(f'"{p}"' for p in parts) + ', "<target>"'
        out_lines.append(
            f'args: [{arg_str}]   # rejected ({op})')
    return "\n".join(out_lines)


def gated_operations_summary(ontology_path):
    """Read the .nt file and produce a short bulleted list of
    destructive_op / protected_* facts for the skill template."""
    bullets = []
    line_re = re.compile(
        r'^<[^>]*org/(?P<s>[^>]+)>\s+<[^>]*org/(?P<p>[^>]+)>\s+'
        r'<[^>]*org/(?P<o>[^>]+)>\s*\.\s*$')
    with open(ontology_path) as f:
        for line in f:
            m = line_re.match(line.strip())
            if not m:
                continue
            s, p, o = m.group("s"), m.group("p"), m.group("o")
            if p == "is_a" and o in (
                "destructive_op", "protected_branch", "protected_namespace",
                "protected_resource", "protected_repo", "protected_database",
                "protected_schema", "protected_role", "protected_service",
            ):
                bullets.append(f"- `{s}` is_a `{o}`")
    if not bullets:
        return "(empty ontology — add facts in `ontologies/<tool>.nt`)"
    if len(bullets) > 12:
        bullets = bullets[:12] + [
            f"- … and {len(bullets) - 12} more (see ontology file)"]
    return "\n".join(bullets)


def build_known_bundle(target, out_dir):
    """Bundle the existing adapter + ontology + generated MCP server +
    skill into out_dir."""
    if target not in KNOWN_TARGETS:
        raise ValueError(f"unknown target {target}")

    info = KNOWN_TARGETS[target]
    adapter = BIN / f"mcpf-{target}"
    ontology = ONTOLOGIES / f"{target}.nt"

    if not adapter.exists():
        raise FileNotFoundError(f"adapter missing: {adapter}")
    if not ontology.exists():
        raise FileNotFoundError(f"ontology missing: {ontology}")

    out = Path(out_dir)
    (out / "bin").mkdir(parents=True, exist_ok=True)
    (out / "ontologies").mkdir(parents=True, exist_ok=True)

    shutil.copy(adapter, out / "bin" / adapter.name)
    os.chmod(out / "bin" / adapter.name, 0o755)
    shutil.copy(ontology, out / "ontologies" / ontology.name)

    mapping = {
        "TOOL_NAME": target,
        "BINARY": info["binary"],
        "GATED_OPERATIONS": gated_operations_summary(ontology),
    }
    (out / "mcp_server.py").write_text(
        render(TEMPLATES / "mcp_server.py.tmpl", mapping))
    os.chmod(out / "mcp_server.py", 0o755)
    (out / "skill.md").write_text(
        render(TEMPLATES / "skill.md.tmpl", mapping))
    (out / "README.md").write_text(
        render_readme(target, info))
    return out


def render_readme(target, info):
    return f"""# mcp-former bundle: {info['label']} ({target})

Generated by **mcp-former**. This bundle wraps `{info['binary']}` behind
a verification gate so an LLM agent can drive it without footguns.

## Layout

```
bin/mcpf-{target}          adapter — gate logic
ontologies/{target}.nt     protection model (edit to add rules)
mcp_server.py              MCP server, callable from Claude Code/Cursor
skill.md                   Anthropic-style skill description
README.md                  this file
```

## Setup

1. **Install tardygrada** (the verification engine):
   <https://github.com/fabio-rovai/tardygrada>

   ```sh
   git clone https://github.com/fabio-rovai/tardygrada
   cd tardygrada && make
   ./tardygrada daemon start
   ```

2. **Load this bundle's ontology into the daemon**:

   Either copy `ontologies/{target}.nt` to tardygrada's `tests/`
   directory and restart the daemon, or live-inject:

   ```sh
   python3 -c "
   import json, socket, re
   from pathlib import Path
   NT_RE = re.compile(r'^<[^>]*org/(?P<s>[^>]+)>\\s+<[^>]*org/(?P<p>[^>]+)>\\s+<[^>]*org/(?P<o>[^>]+)>\\s*\\.\\s*$')
   def send(p):
       s = socket.socket(socket.AF_UNIX); s.connect('/tmp/tardygrada.sock')
       s.sendall((json.dumps(p)+chr(10)).encode()); s.shutdown(socket.SHUT_WR)
       o = b''
       while True:
           d = s.recv(4096)
           if not d: break
           o += d
       return json.loads(o.decode().strip())
   for line in Path('ontologies/{target}.nt').read_text().splitlines():
       m = NT_RE.match(line.strip())
       if m:
           send({{'cmd': 'submit-fact', 'subject': m.group('s'),
                   'predicate': m.group('p'), 'object': m.group('o')}})
   "
   ```

3. **Wire the MCP server into your LLM client**:

   For Claude Code, add to `~/.config/claude/mcp.json`:

   ```json
   {{
     "mcpServers": {{
       "{target}-mcpf": {{
         "command": "python3",
         "args": ["{Path.cwd()}/mcp_server.py"]
       }}
     }}
   }}
   ```

   For Cursor / Continue / etc., consult their MCP config docs.

4. **Verify**:

   ```sh
   ./bin/mcpf-{target} --help-mcpf
   ./bin/mcpf-{target} --explain <some-args>
   ```

## CLI usage (without an LLM)

The adapter works as a drop-in replacement on the command line:

```sh
./bin/mcpf-{target} <args>          # gated
./bin/mcpf-{target} --explain <args> # show the verification trace
./bin/mcpf-{target} --allow-unsafe <args>  # bypass the gate
```

## Editing the protection model

`ontologies/{target}.nt` is the source of truth. Add a fact like:

```
<http://tardygrada.org/my_protected_thing> <http://schema.org/is_a> <http://tardygrada.org/protected_resource> .
```

Then re-inject (step 2 above) or restart the daemon. No code change.

## License

Generated bundle inherits mcp-former's license. The wrapped tool
(`{info['binary']}`) keeps its own license.
"""


# ----------------------------------------------------------------------
# Mode 2: GitHub URL bundle (best-effort)
# ----------------------------------------------------------------------

GITHUB_RE = re.compile(
    r"^https?://github\.com/([^/]+)/([^/?#]+?)(?:\.git)?/?$")


def is_github_url(s):
    return bool(GITHUB_RE.match(s))


def parse_github_url(s):
    m = GITHUB_RE.match(s)
    if not m:
        raise ValueError(f"not a GitHub URL: {s}")
    return m.group(1), m.group(2)


def _toml_section_name(text, section):
    """Find `name = "X"` inside a given TOML section. Naive but works
    for the common single-package Cargo.toml / [project] pyproject.toml
    layouts."""
    in_section = False
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("[") and s.endswith("]"):
            in_section = (s == section)
            continue
        if in_section:
            m = re.match(r'^\s*name\s*=\s*"([^"]+)"', line)
            if m:
                return m.group(1)
    return None


def detect_binary(repo_root, fallback_name):
    """Best-effort detection of the CLI binary name.
    Returns (binary, evidence_lines)."""
    evidence = []
    candidates = []

    # 1. Cargo.toml [[bin]] then [package] name
    cargo = repo_root / "Cargo.toml"
    if cargo.exists():
        text = cargo.read_text()
        bin_name = _toml_section_name(text, "[[bin]]")
        if bin_name:
            candidates.append(bin_name)
            evidence.append(f"Cargo.toml [[bin]] name={bin_name}")
        else:
            pkg_name = _toml_section_name(text, "[package]")
            if pkg_name:
                candidates.append(pkg_name)
                evidence.append(f"Cargo.toml [package] name={pkg_name}")

    # 2. package.json bin
    pkg = repo_root / "package.json"
    if pkg.exists() and not candidates:
        try:
            import json as _json
            data = _json.loads(pkg.read_text())
            bin_entry = data.get("bin")
            if isinstance(bin_entry, dict):
                k = next(iter(bin_entry.keys()))
                candidates.append(k)
                evidence.append(f"package.json bin.{k}")
            elif isinstance(bin_entry, str):
                # bin is a path; the executable name is the package name
                name = data.get("name", "")
                if name:
                    candidates.append(name)
                    evidence.append(f"package.json name={name} bin={bin_entry}")
        except Exception:
            pass

    # 3. pyproject.toml [project.scripts]
    pyp = repo_root / "pyproject.toml"
    if pyp.exists() and not candidates:
        text = pyp.read_text()
        m = re.search(r"\[project\.scripts\]\s*\n([\w-]+)\s*=", text)
        if m:
            candidates.append(m.group(1))
            evidence.append(
                f"pyproject.toml [project.scripts] {m.group(1)}")
        else:
            # fall back to [project] name
            proj_name = _toml_section_name(text, "[project]")
            if proj_name:
                candidates.append(proj_name)
                evidence.append(f"pyproject.toml [project] name={proj_name}")

    # 4. setup.py console_scripts
    setup = repo_root / "setup.py"
    if setup.exists() and not candidates:
        text = setup.read_text()
        m = re.search(r"console_scripts.*?\[\s*['\"]([\w-]+)\s*=",
                       text, re.DOTALL)
        if m:
            candidates.append(m.group(1))
            evidence.append(f"setup.py console_scripts {m.group(1)}")

    # 5. go.mod — use repo name (Go modules don't always declare bin)
    gomod = repo_root / "go.mod"
    if gomod.exists() and not candidates:
        for f in repo_root.rglob("main.go"):
            evidence.append(
                f"go.mod with main.go at {f.relative_to(repo_root)}")
            candidates.append(fallback_name)
            break

    # Final fallback: repo name from the URL (NOT the temp dir name)
    if not candidates:
        candidates.append(fallback_name)
        evidence.append(f"fallback to repo name from URL: {fallback_name}")

    return candidates[0], evidence


def discover_help(binary, repo_root):
    """Try to get --help output. Looks first for a built binary in
    common locations, then PATH."""
    candidates = [
        repo_root / binary,
        repo_root / "bin" / binary,
        repo_root / "build" / binary,
        repo_root / "target" / "release" / binary,
        repo_root / "target" / "debug" / binary,
    ]
    for c in candidates:
        if c.exists() and os.access(c, os.X_OK):
            try:
                r = subprocess.run([str(c), "--help"],
                                    capture_output=True, text=True,
                                    timeout=5)
                return r.stdout or r.stderr, str(c)
            except Exception:
                pass
    # Fallback to PATH
    if shutil.which(binary):
        try:
            r = subprocess.run([binary, "--help"],
                                capture_output=True, text=True, timeout=5)
            return r.stdout or r.stderr, binary
        except Exception:
            pass
    return None, None


def build_repo_bundle(url, out_dir, llm_backend="auto"):
    owner, repo = parse_github_url(url)
    print(f"{DIM}cloning {owner}/{repo}…{NC}")
    work = Path(tempfile.mkdtemp(prefix="mcpf-wrap-"))
    clone_dir = work / "src"
    try:
        subprocess.run(
            ["git", "clone", "--depth=1", url, str(clone_dir)],
            capture_output=True, check=True, timeout=120)
    except subprocess.CalledProcessError as e:
        raise RuntimeError(f"clone failed: {e.stderr.decode()}")

    binary, evidence = detect_binary(clone_dir, fallback_name=repo)
    print(f"{DIM}detected binary: {CYAN}{binary}{NC}")
    for line in evidence:
        print(f"  {DIM}↳ {line}{NC}")

    help_text, help_source = discover_help(binary, clone_dir)
    if help_text:
        print(f"{DIM}got --help from {help_source} "
              f"({len(help_text)} bytes){NC}")
    else:
        print(f"{YELLOW}no --help output available{NC}")

    readme_text = fetch_readme(clone_dir)
    if readme_text:
        print(f"{DIM}got README ({len(readme_text)} bytes){NC}")

    # Extract the actual CLI surface from the source — more
    # authoritative than README, which often skips undocumented
    # commands or uses marketing language.
    print(f"{DIM}scanning source for cobra/clap/click definitions…{NC}")
    surface = extract_surface(clone_dir)
    surface_text = render_surface(surface)
    if surface:
        total = sum(len(v) for v in surface.values())
        framework_summary = ", ".join(
            f"{fw}={len(v)}" for fw, v in surface.items())
        print(f"{DIM}extracted CLI surface: {total} subcommands "
              f"({framework_summary}){NC}")
    else:
        print(f"{YELLOW}no recognised CLI framework patterns "
              f"(cobra/clap/click) — falling back to README only{NC}")

    out = Path(out_dir)
    (out / "bin").mkdir(parents=True, exist_ok=True)
    (out / "ontologies").mkdir(parents=True, exist_ok=True)
    target = re.sub(r"[^a-zA-Z0-9_]", "_", binary)
    onto_path = out / "ontologies" / f"{target}.nt"

    # Ontology generation is MANDATORY for URL mode — never ship a
    # stub bundle. If no LLM backend is available the wrap fails so
    # the user is forced to set up a backend rather than getting
    # silent fallback to a useless adapter.
    print(f"{DIM}generating ontology via LLM (backend: "
          f"{llm_backend})…{NC}")
    nt_text, err = llm_generate_ontology(
        target, binary, help_text, readme_text,
        backend=llm_backend, surface_text=surface_text)
    if not nt_text:
        shutil.rmtree(out, ignore_errors=True)
        raise RuntimeError(
            f"LLM ontology generation failed: {err}\n"
            f"Set ANTHROPIC_API_KEY, install the `claude` CLI, or use "
            f"a built-in target (git, kubectl, gh, aws, psql).")

    ok, msg = validate_ontology(nt_text)
    if not ok:
        # Don't ship invalid Turtle — surface the validator output so
        # the user can see what the LLM produced.
        bad_path = out / "ontologies" / f"{target}.invalid.nt"
        bad_path.write_text(nt_text)
        shutil.rmtree(out, ignore_errors=True)
        raise RuntimeError(
            f"LLM-generated ontology failed validation:\n  {msg}\n"
            f"raw output saved to {bad_path} for inspection.")

    onto_path.write_text(
        f"# Auto-generated by mcpf-wrap from {url}\n"
        f"# Binary: {binary}\n"
        f"# Source: LLM (backend={llm_backend})\n"
        f"# Validator: {msg}\n"
        f"# Review and tighten before production use.\n\n"
        f"{nt_text}\n")
    fact_count = sum(
        1 for line in nt_text.splitlines()
        if line.strip().startswith("<"))
    print(f"  {GREEN}✓ generated {fact_count} facts, "
          f"validated{NC}")

    # Generic adapter — drives any wrapped tool through the ontology.
    # The protection model lives in ontologies/<target>.nt and is loaded
    # into the running tardygrada daemon. The adapter parses argv, asks
    # the daemon "is this verb a destructive_op?" / "is this target a
    # protected_thing?", rejects on a positive answer, otherwise execs
    # the underlying binary.
    stub_adapter = out / "bin" / f"mcpf-{target}"
    stub_adapter.write_text(GENERIC_ADAPTER_TEMPLATE.format(
        target=target, binary=binary))
    os.chmod(stub_adapter, 0o755)

    # Render server + skill from templates with the discovered binary.
    # The GATED_OPERATIONS placeholder is filled with a real bullet
    # list extracted from the freshly written ontology, so the skill
    # tells the LLM exactly what's gated for this tool — not generic
    # git-flavoured examples.
    mapping = {
        "TOOL_NAME": target,
        "BINARY": binary,
        "GATED_OPERATIONS": gated_operations_summary(onto_path),
        "EXAMPLE_DESTRUCTIVE_ARGS": _example_args(onto_path, binary),
    }
    (out / "mcp_server.py").write_text(
        render(TEMPLATES / "mcp_server.py.tmpl", mapping))
    os.chmod(out / "mcp_server.py", 0o755)
    (out / "skill.md").write_text(
        render(TEMPLATES / "skill.md.tmpl", mapping))

    # README — content depends on whether the LLM produced facts
    fact_count_for_readme = sum(
        1 for line in nt_text.splitlines()
        if line.strip().startswith("<"))

    if fact_count_for_readme > 0:
        # Generated bundle with real ontology — render the install README
        readme_body = f"""# mcp-former bundle: {owner}/{repo}

Generated by `mcpf wrap {url}`.

This bundle wraps `{binary}` behind a verification gate so an LLM
agent can drive it without footguns. The protection model has
**{fact_count_for_readme} ontology facts** auto-generated from the
repo's source code (cobra/clap/click definitions where present, plus
README context).

See `AUDIT.md` for the conformance report.

## Layout

```
bin/mcpf-{target}          generic ontology-driven adapter
ontologies/{target}.nt     {fact_count_for_readme} facts (destructive ops, protected resources)
mcp_server.py              MCP server (JSON-RPC over stdio)
skill.md                   Anthropic-style skill description
README.md                  this file
AUDIT.md                   conformance report
```

## Setup

1. **Install tardygrada** (the verification engine):
   <https://github.com/fabio-rovai/tardygrada>

   ```sh
   git clone https://github.com/fabio-rovai/tardygrada
   cd tardygrada && make
   ./tardygrada daemon start
   ```

2. **Load the ontology into the daemon**:

   The easiest path: run `mcpf install {target}` from a fresh clone
   of mcp-former (it auto-loads). For a standalone bundle:

   ```sh
   python3 -c "
   import json, socket, re
   NT_RE = re.compile(r'^<[^>]*org/(?P<s>[^>]+)>\\s+<[^>]*org/(?P<p>[^>]+)>\\s+<[^>]*org/(?P<o>[^>]+)>\\s*\\.\\s*$')
   def send(p):
       s = socket.socket(socket.AF_UNIX); s.connect('/tmp/tardygrada.sock')
       s.sendall((json.dumps(p)+chr(10)).encode()); s.shutdown(socket.SHUT_WR)
       o = b''
       while True:
           d = s.recv(4096)
           if not d: break
           o += d
       return json.loads(o.decode().strip())
   for line in open('ontologies/{target}.nt'):
       m = NT_RE.match(line.strip())
       if m:
           send({{'cmd': 'submit-fact', 'subject': m.group('s'),
                   'predicate': m.group('p'), 'object': m.group('o')}})
   "
   ```

3. **Wire the MCP server into your LLM client**:

   Add to `~/.claude/mcp.json` (Claude Code) or your client's
   equivalent. Replace `<bundle-path>` with the full path to this
   bundle directory (run `pwd` from inside it to get it):

   ```json
   {{
     "mcpServers": {{
       "{target}-mcpf": {{
         "command": "python3",
         "args": ["<bundle-path>/mcp_server.py"]
       }}
     }}
   }}
   ```

4. **Verify**:

   ```sh
   ./bin/mcpf-{target} --help-mcpf
   ./bin/mcpf-{target} --explain <some-args>
   ```

## CLI usage (without an LLM)

The adapter works as a drop-in:

```sh
./bin/mcpf-{target} <args>            # gated
./bin/mcpf-{target} --explain <args>  # show the verification trace
./bin/mcpf-{target} --allow-unsafe <args>  # bypass the gate
```

## Editing the protection model

`ontologies/{target}.nt` is the source of truth. Add a fact like:

```
<http://tardygrada.org/my_protected_thing> <http://schema.org/is_a> <http://tardygrada.org/protected_resource> .
```

After editing, push it to the daemon (step 2 above) or restart the
daemon. No code change.

Detection evidence:

""" + "\n".join(f"- {e}" for e in evidence) + ("""

Help-text source: `""" + str(help_source) + f"` ({len(help_text)} bytes)\n"
            if help_text else "\n_No --help output available — relied on source extraction + README._\n")
    else:
        # LLM ran but produced zero facts — legitimately a read-only
        # tool, or the LLM didn't find anything destructive. Distinct
        # from a "stub": we tried, the ontology is empty by design.
        readme_body = f"""# mcp-former bundle: {owner}/{repo}

Generated by `mcpf wrap {url}`.

The LLM analysed `{binary}`'s surface and produced **0 destructive
operation facts**. This typically means the tool is a read-only
utility (file viewer, formatter, query tool) with no operations
that destroy data irreversibly.

The bundle is still functional — the adapter passes commands through
to `{binary}` unchanged because there's nothing in the ontology to
gate against. If you believe `{binary}` does have destructive
operations the LLM missed, edit `ontologies/{target}.nt` and re-load
into the daemon.

## Layout

```
bin/mcpf-{target}          generic ontology-driven adapter (passthrough)
ontologies/{target}.nt     0 facts — review and add manually if needed
mcp_server.py              MCP server (JSON-RPC over stdio)
skill.md                   Anthropic-style skill description
README.md                  this file
AUDIT.md                   conformance report
```

Detection evidence:

""" + "\n".join(f"- {e}" for e in evidence) + ("""

Help-text source: `""" + str(help_source) + f"` ({len(help_text)} bytes)\n"
            if help_text else "\n_No --help output available — relied on source extraction + README._\n")

    (out / "README.md").write_text(readme_body)

    shutil.rmtree(work, ignore_errors=True)
    return out


# ----------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("target",
        help=f"built-in target ({', '.join(KNOWN_TARGETS)}) or a "
             f"GitHub URL")
    ap.add_argument("--out", default=None,
        help="output directory (default: ./mcp-former-<target>)")
    ap.add_argument("--zip", action="store_true",
        help="also produce a .zip alongside the directory")
    ap.add_argument("--llm-via", choices=("auto", "api", "claude-cli"),
        default="auto",
        help="LLM backend for URL mode. auto (default): API if "
             "ANTHROPIC_API_KEY is set, else claude CLI. "
             "api: force Anthropic API. "
             "claude-cli: force the local `claude` CLI (no API key "
             "needed; uses your Claude Code session).")
    ap.add_argument("--no-audit", action="store_true",
        help="skip the post-bundle conformance audit")
    args = ap.parse_args()

    if is_github_url(args.target):
        owner, repo = parse_github_url(args.target)
        out_name = f"mcp-former-{owner}-{repo}"
        out_dir = args.out or out_name
        print(f"{DIM}mode: github URL → repo bundle "
              f"(LLM backend={args.llm_via}){NC}")
        try:
            out = build_repo_bundle(args.target, out_dir,
                                     llm_backend=args.llm_via)
        except RuntimeError as e:
            print(f"{RED}{e}{NC}", file=sys.stderr)
            return 1
    elif args.target in KNOWN_TARGETS:
        out_name = f"mcp-former-{args.target}"
        out_dir = args.out or out_name
        print(f"{DIM}mode: known target → bundle{NC}")
        out = build_known_bundle(args.target, out_dir)
    else:
        print(f"{RED}unknown target{NC}: {args.target}", file=sys.stderr)
        print(f"  built-in: {', '.join(KNOWN_TARGETS)}", file=sys.stderr)
        print(f"  or paste a GitHub URL", file=sys.stderr)
        return 2

    print(f"{GREEN}✓ wrote bundle to {out}{NC}")

    # Auto-audit the bundle so the README ships with a conformance
    # report. CI-style: a wrapper without an audit report shouldn't be
    # trusted in production. Before the audit, push the freshly
    # generated facts to the running daemon — otherwise the grounding
    # check ALWAYS fails for fresh bundles ("facts not loaded yet"),
    # which is misleading. After this, the audit reflects what the
    # bundle can actually do once installed.
    if not args.no_audit:
        sub_counts, sub_err = submit_bundle_ontology_to_daemon(out)
        if sub_counts and sub_counts["accepted"] + sub_counts["duplicate"] > 0:
            n = sub_counts["accepted"]
            d = sub_counts["duplicate"]
            print(f"{DIM}↳ pre-loaded {n} new + {d} duplicate "
                  f"facts into the daemon for the audit{NC}")
        elif sub_err:
            print(f"{DIM}↳ {sub_err} — audit will skip grounding{NC}")
        run_audit_and_save(out)

    if args.zip:
        zip_path = Path(str(out) + ".zip")
        with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as zf:
            for p in out.rglob("*"):
                if p.is_file():
                    zf.write(p, p.relative_to(out.parent))
        print(f"{GREEN}✓ wrote zip to {zip_path}{NC}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
