#!/usr/bin/env python3
"""
mcpf-psql: a verifiable wrapper around the PostgreSQL CLI (`psql`).

psql is the hardest of the bundled wrappers — destructive ops live in
SQL, not CLI flags. The wrapper extracts SQL from `-c <query>` and
`-f <file>` arguments, parses each statement with a deliberately
conservative regex, and gates each one against the ontology.

Currently gated SQL statements:

    DROP DATABASE       reject (drop_database)
    DROP SCHEMA         reject (drop_schema)
    DROP TABLE          reject (drop_table) + protected_database check
    DROP ROLE / USER    reject (drop_role / drop_user) + protected_role
    DROP EXTENSION      reject (drop_extension)
    TRUNCATE            reject (truncate)
    DELETE without WHERE reject (delete_no_where)
    UPDATE without WHERE reject (update_no_where)
    GRANT SUPERUSER     reject (grant_superuser)

Per-target checks:
    DROP DATABASE postgres       → REJECT (postgres is_a protected_database)
    DROP SCHEMA pg_catalog       → REJECT (protected_schema)
    DROP ROLE postgres           → REJECT (protected_role)

Interactive psql sessions (no -c / -f) pass through unchecked. The
wrapper can't intercept what the user types into the REPL — for that
you'd need to proxy the protocol, which is out of scope here.

Use:
    mcpf-psql -c "SELECT * FROM users LIMIT 10"
    mcpf-psql -c "DROP TABLE users"               # REJECTED
    mcpf-psql -c "DELETE FROM users"              # REJECTED (no WHERE)
    mcpf-psql -f migration.sql                    # parses file, gates each
    mcpf-psql --explain -c "TRUNCATE accounts"
    mcpf-psql --allow-unsafe -c "DROP TABLE old_logs"

Requires the tardygrada daemon and psql CLI.
"""
import argparse
import json
import os
import re
import socket
import subprocess
import sys

SOCK = "/tmp/tardygrada.sock"

GREEN  = "\033[0;32m"
YELLOW = "\033[1;33m"
RED    = "\033[0;31m"
DIM    = "\033[2m"
NC     = "\033[0m"


def daemon_query(claim):
    if not os.path.exists(SOCK):
        return None
    try:
        s = socket.socket(socket.AF_UNIX)
        s.connect(SOCK)
        s.sendall((json.dumps({"cmd": "run", "claim": claim}) + "\n").encode())
        s.shutdown(socket.SHUT_WR)
        buf = b""
        while True:
            chunk = s.recv(4096)
            if not chunk: break
            buf += chunk
        s.close()
        return json.loads(buf.decode().strip())
    except Exception:
        return None


def claim_grounded(claim):
    resp = daemon_query(claim)
    if not resp:
        return False, resp
    if resp.get("result") != "VERIFIED":
        return False, resp
    for t in resp.get("triples", []):
        if t.get("status") == "grounded":
            return True, resp
    return False, resp


def normalize(s):
    return re.sub(r"[^a-zA-Z0-9]", "_", s).strip("_")


# ----------------------------------------------------------------------
# SQL extraction.
#   psql -c "<sql>"   takes a single statement (or several separated by ;)
#   psql -f file.sql  reads from file
#   psql --command=<sql>
#   psql --file=<path>
# ----------------------------------------------------------------------

def extract_sql(args):
    """Return (sql_text, source_label) tuples."""
    out = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-c", "--command") and i + 1 < len(args):
            out.append((args[i + 1], "-c"))
            i += 2
        elif a.startswith("--command="):
            out.append((a.split("=", 1)[1], "--command"))
            i += 1
        elif a in ("-f", "--file") and i + 1 < len(args):
            try:
                with open(args[i + 1]) as fh:
                    out.append((fh.read(), f"-f {args[i+1]}"))
            except (FileNotFoundError, PermissionError, OSError) as e:
                print(f"{YELLOW}[mcpf-psql] could not read "
                      f"{args[i+1]}: {e}{NC}", file=sys.stderr)
            i += 2
        elif a.startswith("--file="):
            path = a.split("=", 1)[1]
            try:
                with open(path) as fh:
                    out.append((fh.read(), f"--file={path}"))
            except (FileNotFoundError, PermissionError, OSError) as e:
                print(f"{YELLOW}[mcpf-psql] could not read "
                      f"{path}: {e}{NC}", file=sys.stderr)
            i += 1
        else:
            i += 1
    return out


# ----------------------------------------------------------------------
# Naive SQL splitter — splits on ; while respecting quoted strings.
# Not bulletproof (won't handle dollar-quoted bodies in functions
# perfectly), but good enough to gate top-level statements.
# ----------------------------------------------------------------------

def split_statements(sql):
    out = []
    buf = []
    in_single = False
    in_double = False
    in_line_comment = False
    in_block_comment = False
    i = 0
    while i < len(sql):
        c = sql[i]
        nxt = sql[i + 1] if i + 1 < len(sql) else ""
        if in_line_comment:
            if c == "\n":
                in_line_comment = False
            i += 1
            continue
        if in_block_comment:
            if c == "*" and nxt == "/":
                in_block_comment = False
                i += 2
                continue
            i += 1
            continue
        if not in_single and not in_double:
            if c == "-" and nxt == "-":
                in_line_comment = True
                i += 2
                continue
            if c == "/" and nxt == "*":
                in_block_comment = True
                i += 2
                continue
            if c == ";":
                stmt = "".join(buf).strip()
                if stmt:
                    out.append(stmt)
                buf = []
                i += 1
                continue
        if c == "'" and not in_double:
            in_single = not in_single
        elif c == '"' and not in_single:
            in_double = not in_double
        buf.append(c)
        i += 1
    final = "".join(buf).strip()
    if final:
        out.append(final)
    return out


# ----------------------------------------------------------------------
# SQL classification — light pattern matching against the leading verb.
# ----------------------------------------------------------------------

DROP_RE = re.compile(
    r"^\s*DROP\s+(DATABASE|SCHEMA|TABLE|ROLE|USER|EXTENSION|VIEW|"
    r"INDEX|FUNCTION|MATERIALIZED\s+VIEW|TRIGGER|TYPE)"
    r"\s+(?:IF\s+EXISTS\s+)?([\w\.\"]+)",
    re.IGNORECASE)

TRUNCATE_RE = re.compile(r"^\s*TRUNCATE\b", re.IGNORECASE)
DELETE_RE = re.compile(r"^\s*DELETE\s+FROM\b", re.IGNORECASE)
UPDATE_RE = re.compile(r"^\s*UPDATE\b", re.IGNORECASE)
WHERE_RE = re.compile(r"\bWHERE\b", re.IGNORECASE)
GRANT_SUPERUSER_RE = re.compile(
    r"^\s*GRANT\s+.*\bSUPERUSER\b|^\s*ALTER\s+ROLE\s+\S+\s+.*\bSUPERUSER\b",
    re.IGNORECASE)


def gate_statement(stmt):
    """Return (allowed, reason, response)."""
    m = DROP_RE.match(stmt)
    if m:
        kind = m.group(1).upper().replace(" ", "_")    # DROP TABLE → TABLE
        target = m.group(2).strip('"').split(".")[-1]
        op_name = f"drop_{kind.lower()}"
        ok, resp = claim_grounded(f"{op_name} is a destructive_op")
        if ok:
            # If the target itself is protected, prefer that as the reason
            tgt_norm = normalize(target)
            if kind == "DATABASE":
                ok2, resp2 = claim_grounded(
                    f"{tgt_norm} is a protected_database")
                if ok2:
                    return False, (f"DROP DATABASE {target}: "
                                    f"protected_database"), resp2
            if kind == "SCHEMA":
                ok2, resp2 = claim_grounded(
                    f"{tgt_norm} is a protected_schema")
                if ok2:
                    return False, (f"DROP SCHEMA {target}: "
                                    f"protected_schema"), resp2
            if kind in ("ROLE", "USER"):
                ok2, resp2 = claim_grounded(
                    f"{tgt_norm} is a protected_role")
                if ok2:
                    return False, (f"DROP {kind} {target}: "
                                    f"protected_role"), resp2
            return False, f"DROP {kind} is destructive_op", resp
        return True, f"DROP {kind} (not gated)", None

    if TRUNCATE_RE.match(stmt):
        ok, resp = claim_grounded("truncate is a destructive_op")
        if ok:
            return False, "TRUNCATE is destructive_op", resp

    if DELETE_RE.match(stmt) and not WHERE_RE.search(stmt):
        ok, resp = claim_grounded("delete_no_where is a destructive_op")
        if ok:
            return False, "DELETE without WHERE is destructive_op", resp

    if UPDATE_RE.match(stmt) and not WHERE_RE.search(stmt):
        ok, resp = claim_grounded("update_no_where is a destructive_op")
        if ok:
            return False, "UPDATE without WHERE is destructive_op", resp

    if GRANT_SUPERUSER_RE.search(stmt):
        ok, resp = claim_grounded("grant_superuser is a destructive_op")
        if ok:
            return False, "GRANT SUPERUSER is destructive_op", resp

    return True, "passes", None


# ----------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
    ap.add_argument("--explain", action="store_true")
    ap.add_argument("--allow-unsafe", action="store_true")
    ap.add_argument("--help-mcpf", action="store_true")
    args, rest = ap.parse_known_args()

    if args.help_mcpf or not rest:
        print(__doc__)
        return 0

    sources = extract_sql(rest)
    if not sources:
        # No -c / -f: interactive psql, can't gate. Pass through.
        if args.explain:
            print(f"{DIM}[mcpf-psql] no -c / -f; interactive session, "
                  f"passing through{NC}", file=sys.stderr)
        try:
            return subprocess.call(["psql"] + rest)
        except FileNotFoundError:
            print(f"{RED}psql not found on PATH.{NC}", file=sys.stderr)
            return 127

    blocked = []
    inspected = 0
    for sql_text, src in sources:
        for stmt in split_statements(sql_text):
            inspected += 1
            allowed, reason, resp = gate_statement(stmt)
            if args.explain:
                tag = f"{GREEN}PASS{NC}" if allowed else f"{RED}BLOCK{NC}"
                preview = stmt[:60] + ("…" if len(stmt) > 60 else "")
                print(f"{DIM}[mcpf-psql] {src}: {tag} {preview} "
                      f"({reason}){NC}", file=sys.stderr)
            if not allowed:
                blocked.append((stmt, reason, resp))

    if args.explain:
        print(f"{DIM}[mcpf-psql] inspected {inspected} statements, "
              f"{len(blocked)} blocked{NC}", file=sys.stderr)

    if blocked and not args.allow_unsafe:
        print(f"{RED}REJECTED{NC} by mcp-former: "
              f"{len(blocked)} blocked statement(s)", file=sys.stderr)
        for stmt, reason, resp in blocked:
            preview = stmt[:80] + ("…" if len(stmt) > 80 else "")
            print(f"  {RED}✗{NC} {preview}", file=sys.stderr)
            print(f"    {DIM}{reason}{NC}", file=sys.stderr)
            if resp:
                for t in resp.get("triples", []):
                    if t.get("status") == "grounded":
                        print(f"    {DIM}grounded: {t['s']} {t['p']} "
                              f"{t['o']}  (tier={t.get('tier','?')}){NC}",
                              file=sys.stderr)
        print(f"  {DIM}override with --allow-unsafe if you really mean it"
              f"{NC}", file=sys.stderr)
        return 2

    try:
        return subprocess.call(["psql"] + rest)
    except FileNotFoundError:
        print(f"{RED}psql not found on PATH.{NC}", file=sys.stderr)
        return 127


if __name__ == "__main__":
    sys.exit(main())
