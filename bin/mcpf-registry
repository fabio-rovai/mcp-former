#!/usr/bin/env python3
"""
mcpf registry — list and install wrappers from a registry index.

Today the registry is local (registry/index.json in this repo).
Future: a hosted index URL with versioning + signing.

Subcommands:

    mcpf list                   show available wrappers
    mcpf install NAME           install wrapper NAME's bundle into ./wrappers/NAME/
    mcpf install NAME --to DIR  custom install location
    mcpf show NAME              show full registry record

Examples:

    mcpf list
    mcpf install git
    mcpf install kubectl --to ~/mcpf/kubectl
"""
import argparse
import json
import os
import re
import shutil
import socket
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
REGISTRY_INDEX = ROOT / "registry" / "index.json"
TARDY_SOCK = "/tmp/tardygrada.sock"

NT_RE = re.compile(
    r'^<[^>]*org/(?P<s>[^>]+)>\s+<[^>]*org/(?P<p>[^>]+)>\s+'
    r'<[^>]*org/(?P<o>[^>]+)>\s*\.\s*$')

GREEN  = "\033[0;32m"
YELLOW = "\033[1;33m"
RED    = "\033[0;31m"
DIM    = "\033[2m"
CYAN   = "\033[0;36m"
NC     = "\033[0m"


def load_index():
    if not REGISTRY_INDEX.exists():
        print(f"{RED}registry index missing: {REGISTRY_INDEX}{NC}",
              file=sys.stderr)
        sys.exit(1)
    return json.loads(REGISTRY_INDEX.read_text())


def _daemon_send(payload):
    """Send one JSON request to the tardygrada daemon and return the
    parsed response. Caller must check daemon availability first."""
    s = socket.socket(socket.AF_UNIX)
    s.connect(TARDY_SOCK)
    s.sendall((json.dumps(payload) + "\n").encode())
    s.shutdown(socket.SHUT_WR)
    buf = b""
    while True:
        chunk = s.recv(4096)
        if not chunk: break
        buf += chunk
    s.close()
    return json.loads(buf.decode().strip())


def submit_ontology_to_daemon(ontology_path):
    """Parse an .nt file and submit each fact to the running daemon.
    Returns (counts_dict, error_str_or_None). counts has keys:
    accepted, duplicate, derived, conflict, rejected, other."""
    if not os.path.exists(TARDY_SOCK):
        return None, "tardygrada daemon not running (no socket)"
    counts = {"accepted": 0, "duplicate": 0, "derived": 0,
              "conflict": 0, "rejected": 0, "other": 0}
    try:
        with open(ontology_path) as f:
            for line in f:
                m = NT_RE.match(line.strip())
                if not m:
                    continue
                try:
                    r = _daemon_send({
                        "cmd": "submit-fact",
                        "subject": m.group("s"),
                        "predicate": m.group("p"),
                        "object": m.group("o"),
                    })
                except Exception:
                    counts["other"] += 1
                    continue
                status = r.get("status", "other")
                counts[status] = counts.get(status, 0) + 1
    except Exception as e:
        return None, f"failed to read ontology: {e}"
    return counts, None


def cmd_list(args):
    idx = load_index()
    print(f"{DIM}{idx['description']}{NC}")
    print(f"{DIM}registry v{idx['registry_version']}, "
          f"{len(idx['wrappers'])} wrappers available{NC}\n")

    name_w = max(len(w["name"]) for w in idx["wrappers"])
    for w in idx["wrappers"]:
        cats = ", ".join(w.get("categories", []))
        print(f"  {CYAN}{w['name']:{name_w}s}{NC}  "
              f"{DIM}v{w['version']:6s}  "
              f"{w['description']:48s}  "
              f"[{cats}]{NC}")
    print(f"\n  {DIM}Run `mcpf install <name>` to add a wrapper to "
          f"the current directory.{NC}")
    return 0


def cmd_show(args):
    idx = load_index()
    for w in idx["wrappers"]:
        if w["name"] == args.name:
            print(json.dumps(w, indent=2))
            return 0
    print(f"{RED}wrapper not found: {args.name}{NC}", file=sys.stderr)
    return 2


def cmd_install(args):
    idx = load_index()
    entry = next((w for w in idx["wrappers"] if w["name"] == args.name), None)
    if not entry:
        print(f"{RED}unknown wrapper: {args.name}{NC}", file=sys.stderr)
        print(f"  available: {', '.join(w['name'] for w in idx['wrappers'])}",
              file=sys.stderr)
        return 2

    adapter_src = ROOT / entry["adapter_path"]
    ontology_src = ROOT / entry["ontology_path"]
    if not adapter_src.exists() or not ontology_src.exists():
        print(f"{RED}wrapper assets missing in this checkout:{NC}",
              file=sys.stderr)
        print(f"  expected: {adapter_src}, {ontology_src}", file=sys.stderr)
        return 1

    # Default install location: ./wrappers/<name>/
    target_dir = Path(args.to) if args.to else (
        Path.cwd() / "wrappers" / args.name)
    (target_dir / "bin").mkdir(parents=True, exist_ok=True)
    (target_dir / "ontologies").mkdir(parents=True, exist_ok=True)

    shutil.copy(adapter_src, target_dir / "bin" / adapter_src.name)
    os.chmod(target_dir / "bin" / adapter_src.name, 0o755)
    shutil.copy(ontology_src, target_dir / "ontologies" / ontology_src.name)

    # Generate the MCP server + skill via mcpf-wrap on the same target.
    # mcpf-wrap --out <dir> already writes the full bundle layout.
    import subprocess
    wrap_bin = ROOT / "bin" / "mcpf-wrap"
    if wrap_bin.exists():
        # Run mcpf-wrap into a temp dir, then copy the generated
        # mcp_server.py + skill.md + README.md across.
        import tempfile
        with tempfile.TemporaryDirectory() as tmp:
            r = subprocess.run(
                [str(wrap_bin), entry["name"], "--out", tmp],
                capture_output=True, text=True)
            if r.returncode == 0:
                for fname in ("mcp_server.py", "skill.md", "README.md"):
                    src = Path(tmp) / fname
                    if src.exists():
                        shutil.copy(src, target_dir / fname)
                if (target_dir / "mcp_server.py").exists():
                    os.chmod(target_dir / "mcp_server.py", 0o755)

    print(f"{GREEN}✓ installed {entry['name']} v{entry['version']} → "
          f"{target_dir}{NC}")
    print(f"  {DIM}adapter:    bin/{adapter_src.name}{NC}")
    print(f"  {DIM}ontology:   ontologies/{ontology_src.name} "
          f"({entry.get('ontology_facts', '?')} facts){NC}")
    if (target_dir / "mcp_server.py").exists():
        print(f"  {DIM}MCP server: mcp_server.py{NC}")
        print(f"  {DIM}skill:      skill.md{NC}")

    # Auto-load the ontology into the running daemon if available and
    # the user hasn't opted out.
    if not args.no_load:
        installed_onto = target_dir / "ontologies" / ontology_src.name
        counts, err = submit_ontology_to_daemon(installed_onto)
        if err:
            print(f"\n  {YELLOW}↳ daemon load skipped: {err}{NC}")
            print(f"  {DIM}Start it with `tardy daemon start`, then "
                  f"re-run with `mcpf install --reload {entry['name']}`"
                  f" to push the facts.{NC}")
        else:
            new = counts.get("accepted", 0)
            dup = counts.get("duplicate", 0) + counts.get("derived", 0)
            bad = counts.get("conflict", 0) + counts.get("rejected", 0)
            other = counts.get("other", 0)
            extra = f", {bad} blocked" if bad else ""
            extra += f", {other} errors" if other else ""
            print(f"\n  {GREEN}↳ loaded into tardygrada daemon: "
                  f"{new} new, {dup} already-known{extra}{NC}")

    print(f"\n  {DIM}Next: wire mcp_server.py into your LLM client "
          f"(see README.md).{NC}")
    return 0


def cmd_reload(args):
    """Re-submit a wrapper's ontology into the running daemon. Useful
    after editing the ontology or restarting the daemon."""
    idx = load_index()
    entry = next((w for w in idx["wrappers"] if w["name"] == args.name), None)
    if not entry:
        print(f"{RED}unknown wrapper: {args.name}{NC}", file=sys.stderr)
        return 2
    # Look in the standard install location first, fall back to the
    # repo's bundled copy.
    candidates = [
        Path.cwd() / "wrappers" / args.name / "ontologies"
            / Path(entry["ontology_path"]).name,
        ROOT / entry["ontology_path"],
    ]
    onto_path = next((p for p in candidates if p.exists()), None)
    if not onto_path:
        print(f"{RED}no ontology file found for {args.name}{NC}",
              file=sys.stderr)
        for c in candidates:
            print(f"  tried: {c}", file=sys.stderr)
        return 1
    counts, err = submit_ontology_to_daemon(onto_path)
    if err:
        print(f"{RED}daemon load failed: {err}{NC}", file=sys.stderr)
        return 1
    new = counts.get("accepted", 0)
    dup = counts.get("duplicate", 0) + counts.get("derived", 0)
    bad = counts.get("conflict", 0) + counts.get("rejected", 0)
    print(f"{GREEN}✓ reloaded {entry['name']} from {onto_path}{NC}")
    print(f"  {DIM}{new} new, {dup} already-known"
          f"{f', {bad} blocked' if bad else ''}{NC}")
    return 0


def main():
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", help="list available wrappers")

    p_show = sub.add_parser("show", help="show full registry record")
    p_show.add_argument("name")

    p_inst = sub.add_parser("install", help="install a wrapper")
    p_inst.add_argument("name")
    p_inst.add_argument("--to", default=None,
        help="install location (default ./wrappers/<name>)")
    p_inst.add_argument("--no-load", action="store_true",
        help="don't auto-submit the ontology into the running "
             "tardygrada daemon")

    p_reload = sub.add_parser("reload",
        help="re-submit a wrapper's ontology to the running daemon")
    p_reload.add_argument("name")

    args = ap.parse_args()

    if args.cmd == "list":     return cmd_list(args)
    if args.cmd == "show":     return cmd_show(args)
    if args.cmd == "install":  return cmd_install(args)
    if args.cmd == "reload":   return cmd_reload(args)
    return 2


if __name__ == "__main__":
    sys.exit(main())
