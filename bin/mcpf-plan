#!/usr/bin/env python3
"""
mcpf plan — discover a target tool's CLI surface, classify each
subcommand by destructiveness, and emit a Terraform-style plan against
the target's ontology file.

Currently supports: git (parses `git help -a`).

Output mirrors `terraform plan`:

    $ mcpf plan git
    [1/4] discovering surface area ......... 162 subcommands found
    [2/4] classifying ...................... 105 read-only / 42 mutating / 15 destructive
    [3/4] generating frames ................ 5 new destructive_op facts
    [4/4] diff vs ontologies/git.nt
      + add: filter_branch is_a destructive_op
      + add: rm is_a destructive_op
      ...

    Plan: 5 to add, 0 to modify, 0 to remove.
    Run with --apply to commit.

Architecture:

    tool --help                 <-- whitebox introspection source
        │
        ▼
    parse subcommand list (name + one-line description)
        │
        ▼
    heuristic classifier (keyword-based; LLM if ANTHROPIC_API_KEY set)
        │
        ▼
    frame generation (emit destructive_op facts)
        │
        ▼
    diff vs ontologies/<target>.nt
        │
        ▼
    print plan; --apply writes the file (and submits to tardygrada
    daemon if --reload-daemon)

Use:
    mcpf plan git
    mcpf plan git --apply
    mcpf plan git --apply --reload-daemon
    mcpf plan git --explain
    mcpf plan git --target /path/to/git.nt
"""
import argparse
import json
import os
import re
import socket
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TARDY_SOCK = "/tmp/tardygrada.sock"

GREEN  = "\033[0;32m"
YELLOW = "\033[1;33m"
RED    = "\033[0;31m"
DIM    = "\033[2m"
CYAN   = "\033[0;36m"
NC     = "\033[0m"


# ----------------------------------------------------------------------
# Discovery — target-specific
# ----------------------------------------------------------------------

def discover_git():
    """Run `git help -a` and parse the indented subcommand listing."""
    out = subprocess.run(["git", "help", "-a"], capture_output=True,
                         text=True).stdout
    cmds = []
    line_re = re.compile(r"^\s{3}([a-z][a-z0-9-]+)\s+(.+?)\s*$")
    for line in out.splitlines():
        m = line_re.match(line)
        if m:
            cmds.append((m.group(1), m.group(2).strip()))
    seen = {}
    for name, desc in cmds:
        if name not in seen:
            seen[name] = desc
    return sorted(seen.items())


DISCOVERERS = {
    "git": discover_git,
}


# ----------------------------------------------------------------------
# Classification — heuristic by keyword.
# Conservative: when in doubt, classify as mutating, not read-only.
# ----------------------------------------------------------------------

DESTRUCTIVE_KEYWORDS = [
    "delete", "remove", "destroy", "discard", "purge", "expire",
    "prune", "filter-branch", "rewrite", "wipe", "force",
]

READ_KEYWORDS = [
    "show", "list", "print", "display", "inspect", "verify",
    "summari", "describe", "report", "compare", "search", "find",
    "browse", "view", "explain", "log", "status",
    "give an object", "graphical", "binary search",
]

ALWAYS_DESTRUCTIVE = {
    "clean":         "removes untracked files irreversibly",
    "reset":         "can rewrite refs (--hard discards working tree)",
    "filter-branch": "rewrites every commit in the history",
    "filter-repo":   "rewrites every commit in the history",
    "rm":            "removes files from the index and working tree",
    "gc":            "garbage-collects loose objects",
    "reflog":        "expire/delete subcommands erase recovery refs",
}

MUTATING_KEYWORDS = [
    "add", "create", "update", "apply", "fetch", "commit",
    "merge", "rebase", "tag", "stash", "import", "init",
    "checkout", "switch", "restore", "pull", "push",
    "move", "rename", "record", "join", "reapply", "reset",
]


def classify(name, desc, explain=False):
    txt = f"{name} {desc}".lower()
    why = []

    if name in ALWAYS_DESTRUCTIVE:
        why.append(f"name in ALWAYS_DESTRUCTIVE ({ALWAYS_DESTRUCTIVE[name]})")
        cls = "destructive"
    else:
        for kw in DESTRUCTIVE_KEYWORDS:
            if kw in txt:
                why.append(f"matched destructive keyword '{kw}'")
                cls = "destructive"
                break
        else:
            for kw in MUTATING_KEYWORDS:
                if kw in txt:
                    why.append(f"matched mutating keyword '{kw}'")
                    cls = "mutating"
                    break
            else:
                for kw in READ_KEYWORDS:
                    if kw in txt:
                        why.append(f"matched read-only keyword '{kw}'")
                        cls = "read_only"
                        break
                else:
                    why.append("no keyword matched; default = mutating")
                    cls = "mutating"

    if explain:
        return cls, why
    return cls, None


# ----------------------------------------------------------------------
# Frame generation
# ----------------------------------------------------------------------

def normalize_local(name):
    """git subcommand names like "filter-branch" → ontology-friendly
    "filter_branch" (no hyphens, IRI-safe)."""
    return name.replace("-", "_")


def generate_facts(classified, target):
    """For destructive subcommands, emit  <name> is_a destructive_op."""
    facts = []
    for name, cls, _, _ in classified:
        if cls == "destructive":
            facts.append((normalize_local(name), "is_a", "destructive_op"))
    return facts


# ----------------------------------------------------------------------
# Ontology diff
# ----------------------------------------------------------------------

NT_RE = re.compile(
    r'^<[^>]*org/(?P<s>[^>]+)>\s+<[^>]*org/(?P<p>[^>]+)>\s+'
    r'<[^>]*org/(?P<o>[^>]+)>\s*\.\s*$'
)


def parse_ontology(path):
    triples = set()
    if not os.path.exists(path):
        return triples
    with open(path) as f:
        for line in f:
            m = NT_RE.match(line.strip())
            if m:
                triples.add((m.group("s"), m.group("p"), m.group("o")))
    return triples


def append_facts(path, header, triples):
    """Append-only: keep existing file, add new triples."""
    existing = parse_ontology(path)
    new = [t for t in triples if t not in existing]
    if not new:
        return 0
    with open(path, "a") as f:
        f.write(f"\n# {header}\n")
        for (s, p, o) in new:
            f.write(f"<http://tardygrada.org/{s}> "
                    f"<http://schema.org/{p}> "
                    f"<http://tardygrada.org/{o}> .\n")
    return len(new)


# ----------------------------------------------------------------------
# Tardygrada submit-fact for live injection
# ----------------------------------------------------------------------

def submit_to_tardygrada(triples):
    """Push facts into the running tardygrada daemon's LEARNED tier
    so verification works without a daemon restart."""
    if not os.path.exists(TARDY_SOCK):
        return 0, "tardygrada daemon not running (no socket)"
    submitted = 0
    for (s, p, o) in triples:
        try:
            sk = socket.socket(socket.AF_UNIX)
            sk.connect(TARDY_SOCK)
            sk.sendall((json.dumps({
                "cmd": "submit-fact",
                "subject": s, "predicate": p, "object": o,
            }) + "\n").encode())
            sk.shutdown(socket.SHUT_WR)
            buf = b""
            while True:
                c = sk.recv(4096)
                if not c: break
                buf += c
            sk.close()
            resp = json.loads(buf.decode().strip())
            if resp.get("ok"):
                submitted += 1
        except Exception:
            pass
    return submitted, None


# ----------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("target", choices=list(DISCOVERERS.keys()),
        help="software to introspect")
    ap.add_argument("--apply", action="store_true",
        help="write the plan to the ontology file")
    ap.add_argument("--reload-daemon", action="store_true",
        help="after --apply, push facts to the running tardygrada "
             "daemon (LEARNED tier)")
    ap.add_argument("--explain", action="store_true",
        help="print classifier reasoning per subcommand")
    ap.add_argument("--target", dest="ontology_path", default=None,
        help="output ontology path (default ontologies/<target>.nt)")
    args = ap.parse_args()

    out_path = (args.ontology_path or
        os.path.join(ROOT, "ontologies", f"{args.target}.nt"))

    print(f"{DIM}[1/4] discovering surface area{NC} ", end="", flush=True)
    cmds = DISCOVERERS[args.target]()
    print(f"{DIM}........ {NC}{len(cmds)} subcommands found")

    print(f"{DIM}[2/4] classifying{NC} ", end="", flush=True)
    classified = []
    counts = {"read_only": 0, "mutating": 0, "destructive": 0}
    for name, desc in cmds:
        cls, why = classify(name, desc, explain=args.explain)
        classified.append((name, cls, desc, why))
        counts[cls] += 1
    print(f"{DIM}............... {NC}"
          f"{counts['read_only']} read-only / "
          f"{counts['mutating']} mutating / "
          f"{RED}{counts['destructive']} destructive{NC}")

    if args.explain:
        for name, cls, desc, why in classified:
            color = (RED if cls == "destructive" else
                     YELLOW if cls == "mutating" else DIM)
            print(f"  {color}{cls:12s}{NC} {name:20s} "
                  f"{DIM}{desc[:50]}{NC}")
            for w in why or []:
                print(f"    {DIM}↳ {w}{NC}")

    print(f"{DIM}[3/4] generating frames{NC} ", end="", flush=True)
    facts = generate_facts(classified, args.target)
    print(f"{DIM}......... {NC}{len(facts)} destructive_op facts")

    print(f"{DIM}[4/4] diff vs {out_path}{NC}")
    existing = parse_ontology(out_path)
    proposed = set(facts)
    to_add = sorted(proposed - existing)
    to_remove = sorted(
        t for t in existing
        if t[1] == "is_a" and t[2] == "destructive_op" and t not in proposed
    )

    for (s, p, o) in to_add:
        print(f"  {GREEN}+ add{NC}    {s} {p} {o}")
    for (s, p, o) in to_remove:
        print(f"  {RED}- remove{NC} {s} {p} {o}")
    unchanged = len(proposed & existing)
    if unchanged:
        print(f"  {DIM}~ unchanged: {unchanged}{NC}")

    print()
    print(f"Plan: {GREEN}{len(to_add)} to add{NC}, "
          f"{YELLOW}0 to modify{NC}, "
          f"{RED}{len(to_remove)} to remove{NC}.")

    if not args.apply:
        if to_add or to_remove:
            print(f"Run with {CYAN}--apply{NC} to commit.")
        return 0

    if not (to_add or to_remove):
        print(f"{DIM}Nothing to apply.{NC}")
        return 0

    if to_remove:
        print(f"{YELLOW}Note: --apply currently only adds; "
              f"{len(to_remove)} stale facts left in place.{NC}")
    n = append_facts(out_path,
        f"auto-generated by mcpf plan {args.target}", to_add)
    print(f"{GREEN}Wrote {n} facts to {out_path}{NC}")

    if args.reload_daemon:
        print(f"{DIM}Submitting to tardygrada daemon...{NC}")
        sub, err = submit_to_tardygrada(to_add)
        if err:
            print(f"{YELLOW}Skipped: {err}{NC}")
        else:
            print(f"{GREEN}Submitted {sub}/{len(to_add)} facts to "
                  f"LEARNED tier{NC}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
