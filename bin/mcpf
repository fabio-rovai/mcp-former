#!/usr/bin/env python3
"""
mcpf — top-level CLI for mcp-former.

Subcommands:
    list                 list wrappers in the registry
    install NAME         install a wrapper bundle into ./wrappers/NAME
    show NAME            show full registry record for NAME
    plan TARGET          introspect target software, emit a Terraform-
                          style plan against ontologies/TARGET.nt
    apply TARGET         run plan and write the result to disk
    wrap TARGET|URL      generate a self-contained bundle (adapter +
                          ontology + MCP server + skill) for a known
                          target or a GitHub repo URL
    git GIT-ARGS         drive git through the verification gate
    kubectl K8S-ARGS     drive kubectl through the verification gate

Examples:
    mcpf plan git
    mcpf plan kubectl --llm
    mcpf plan git --apply --reload-daemon
    mcpf plan git --explain
    mcpf git status
    mcpf git --explain branch -D main
    mcpf kubectl get pods
    mcpf kubectl --explain delete pod coredns -n kube-system

This is a thin dispatcher; each subcommand is implemented as its own
mcpf-<sub> script in bin/. Keeps each tool single-purpose and testable
in isolation.
"""
import os
import sys

BIN = os.path.dirname(os.path.abspath(__file__))


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0

    sub = sys.argv[1]
    rest = sys.argv[2:]

    if sub == "plan":
        target = os.path.join(BIN, "mcpf-plan")
        os.execv(target, [target] + rest)
    if sub == "apply":
        # apply == plan --apply
        target = os.path.join(BIN, "mcpf-plan")
        os.execv(target, [target] + rest + ["--apply"])
    if sub == "git":
        target = os.path.join(BIN, "mcpf-git")
        os.execv(target, [target] + rest)
    if sub == "kubectl":
        target = os.path.join(BIN, "mcpf-kubectl")
        os.execv(target, [target] + rest)
    if sub == "gh":
        target = os.path.join(BIN, "mcpf-gh")
        os.execv(target, [target] + rest)
    if sub == "aws":
        target = os.path.join(BIN, "mcpf-aws")
        os.execv(target, [target] + rest)
    if sub == "psql":
        target = os.path.join(BIN, "mcpf-psql")
        os.execv(target, [target] + rest)
    if sub == "wrap":
        target = os.path.join(BIN, "mcpf-wrap")
        os.execv(target, [target] + rest)
    if sub in ("list", "install", "show"):
        # Registry subcommands — dispatch to mcpf-registry
        target = os.path.join(BIN, "mcpf-registry")
        os.execv(target, [target, sub] + rest)
    if sub == "registry":
        target = os.path.join(BIN, "mcpf-registry")
        os.execv(target, [target] + rest)

    print(f"unknown subcommand: {sub}", file=sys.stderr)
    print("run 'mcpf --help' for usage", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
