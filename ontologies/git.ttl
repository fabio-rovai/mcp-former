# mcp-former git A-Box.
#
# Each instance is multi-typed: a domain class (what it IS — Branch,
# Ref, …) AND when applicable a protection class (whether it's gated
# — ProtectedBranch, ProtectedRef, …). OWL-RL closure makes both
# inheritance chains queryable.

@prefix :     <http://tardygrada.org/mcpf/> .
@prefix git:  <http://tardygrada.org/mcpf/git/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


# ----------------------------------------------------------------------
# Resources — multi-typed instances
# ----------------------------------------------------------------------

git:main    a :Branch, :ProtectedBranch ;
            rdfs:label "main" ;
            :rationale "Default branch in modern repos; production state." .

git:master  a :Branch, :ProtectedBranch ;
            rdfs:label "master" ;
            :rationale "Legacy default branch; often production." .

git:develop a :Branch, :ProtectedBranch ;
            rdfs:label "develop" ;
            :rationale "Standard integration branch in git-flow." .

git:release a :Branch, :ProtectedBranch ;
            rdfs:label "release" ;
            :rationale "Release candidate branch." .

git:HEAD    a :Ref, :ProtectedRef ;
            rdfs:label "HEAD" ;
            :rationale "Current ref; must not be moved imperatively." .


# ----------------------------------------------------------------------
# Operations — declare the target class for each, so the gate can
# look up "what does this op operate on?"
# ----------------------------------------------------------------------

git:branch_delete    a :GitDestructiveOp ;
                     rdfs:label "git branch -d/-D" ;
                     :tool :GitTool ;
                     :targetClass :Branch ;
                     :cliFlag "branch" ;
                     :cliFlag "-D" .

git:tag_delete       a :GitDestructiveOp ;
                     rdfs:label "git tag -d" ;
                     :tool :GitTool ;
                     :targetClass :Tag ;
                     :cliFlag "tag" ;
                     :cliFlag "-d" .

git:push_force       a :GitDestructiveOp ;
                     rdfs:label "git push --force" ;
                     :tool :GitTool ;
                     :targetClass :Ref ;
                     :cliFlag "push" ;
                     :cliFlag "--force" .

git:reset_hard       a :GitDestructiveOp ;
                     rdfs:label "git reset --hard" ;
                     :tool :GitTool ;
                     :targetClass :WorkingTree ;
                     :cliFlag "reset" ;
                     :cliFlag "--hard" .

git:clean_force      a :GitDestructiveOp ;
                     rdfs:label "git clean -f" ;
                     :tool :GitTool ;
                     :targetClass :WorkingTree ;
                     :cliFlag "clean" ;
                     :cliFlag "-f" .

git:checkout_discard a :GitDestructiveOp ;
                     rdfs:label "git checkout -- PATH" ;
                     :tool :GitTool ;
                     :targetClass :WorkingTree ;
                     :cliFlag "checkout" ;
                     :cliFlag "--" .
