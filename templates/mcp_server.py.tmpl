#!/usr/bin/env python3
"""
{{TOOL_NAME}} MCP server — generated by mcp-former.

Exposes {{TOOL_NAME}} as an MCP server. LLM clients (Claude Code,
Cursor, Continue, etc.) can call this server's tools and every call
goes through the tardygrada verification gate before it touches
{{TOOL_NAME}}.

The gate is data-driven: the protection model lives in
ontologies/{{TOOL_NAME}}.nt, not in code.

Protocol: JSON-RPC 2.0 over stdio with Content-Length framing
(MCP standard).

Tools exposed:

    {{TOOL_NAME}}_run         — run any {{TOOL_NAME}} subcommand,
                                 gated against the ontology
    {{TOOL_NAME}}_explain     — same, but with --explain trace
    {{TOOL_NAME}}_describe_gate — describe what the gate would do
                                   without running

Setup (Claude Code):

    Add to ~/.config/claude/mcp.json (or your client's equivalent):

    {
      "mcpServers": {
        "{{TOOL_NAME}}-mcpf": {
          "command": "python3",
          "args": ["/path/to/mcp_server.py"]
        }
      }
    }

Requires:
    - tardygrada daemon running (/tmp/tardygrada.sock)
    - {{BINARY}} on PATH
"""
import json
import os
import socket
import subprocess
import sys

TOOL_NAME = "{{TOOL_NAME}}"
BINARY = "{{BINARY}}"

# Path to the bundled adapter that knows the gate logic. By default we
# look next to this server file.
HERE = os.path.dirname(os.path.abspath(__file__))
ADAPTER = os.path.join(HERE, "bin", f"mcpf-{TOOL_NAME}")
SOCK = "/tmp/tardygrada.sock"


# ----------------------------------------------------------------------
# Stdio framing (Content-Length headers, JSON body)
# ----------------------------------------------------------------------

def write_message(msg):
    body = json.dumps(msg).encode()
    sys.stdout.buffer.write(
        b"Content-Length: %d\r\n\r\n" % len(body))
    sys.stdout.buffer.write(body)
    sys.stdout.buffer.flush()


def read_message():
    headers = b""
    while True:
        ch = sys.stdin.buffer.read(1)
        if not ch:
            return None
        headers += ch
        if headers.endswith(b"\r\n\r\n"):
            break
    n = 0
    for line in headers.decode().split("\r\n"):
        if line.lower().startswith("content-length:"):
            n = int(line.split(":", 1)[1].strip())
    body = sys.stdin.buffer.read(n)
    return json.loads(body.decode())


# ----------------------------------------------------------------------
# Tool definitions (advertised to MCP clients on initialize)
# ----------------------------------------------------------------------

TOOLS = [
    {
        "name": f"{TOOL_NAME}_run",
        "description": (
            f"Run a {TOOL_NAME} command. Destructive operations are "
            f"rejected by the verification gate unless allow_unsafe=true. "
            f"Returns stdout/stderr and exit code."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "args": {
                    "type": "array",
                    "items": {"type": "string"},
                    "description": (
                        f"Arguments to pass to {TOOL_NAME}, e.g. "
                        f"['status', '-s'] for `{TOOL_NAME} status -s`."
                    ),
                },
                "allow_unsafe": {
                    "type": "boolean",
                    "description": (
                        "If true, bypass the verification gate. Only use "
                        "when you have explicitly confirmed the operation "
                        "is intended."
                    ),
                    "default": False,
                },
            },
            "required": ["args"],
        },
    },
    {
        "name": f"{TOOL_NAME}_describe_gate",
        "description": (
            f"Describe what the verification gate would do for the given "
            f"{TOOL_NAME} args, without running the command. Returns the "
            f"grounded triples and decision."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "args": {
                    "type": "array",
                    "items": {"type": "string"},
                },
            },
            "required": ["args"],
        },
    },
]


# ----------------------------------------------------------------------
# Tool execution — shells out to the mcpf-* adapter
# ----------------------------------------------------------------------

def run_via_adapter(args, explain=False, allow_unsafe=False, dry_run=False):
    cmd = [ADAPTER]
    if explain:
        cmd.append("--explain")
    if allow_unsafe:
        cmd.append("--allow-unsafe")
    cmd.extend(args)
    try:
        if dry_run:
            # Dry-run: only run the gate, don't invoke the underlying
            # binary. The adapter's --explain mode dumps the gate trace
            # to stderr; we redirect a fake binary so subprocess.call
            # fails out cleanly without side effects.
            env = os.environ.copy()
            env["PATH"] = "/dev/null"
            r = subprocess.run(cmd, capture_output=True, text=True,
                               env=env, timeout=15)
        else:
            r = subprocess.run(cmd, capture_output=True, text=True,
                               timeout=120)
        return {
            "stdout": r.stdout,
            "stderr": r.stderr,
            "exit_code": r.returncode,
        }
    except FileNotFoundError as e:
        return {"stdout": "", "stderr": str(e), "exit_code": 127}
    except subprocess.TimeoutExpired:
        return {"stdout": "", "stderr": "command timed out",
                "exit_code": 124}


# ----------------------------------------------------------------------
# JSON-RPC dispatcher
# ----------------------------------------------------------------------

def handle(req):
    method = req.get("method")
    rid = req.get("id")
    params = req.get("params", {}) or {}

    if method == "initialize":
        return {
            "jsonrpc": "2.0", "id": rid,
            "result": {
                "protocolVersion": "2024-11-05",
                "capabilities": {"tools": {}},
                "serverInfo": {
                    "name": f"{TOOL_NAME}-mcpf",
                    "version": "0.1.0",
                },
            },
        }

    if method == "tools/list":
        return {"jsonrpc": "2.0", "id": rid, "result": {"tools": TOOLS}}

    if method == "tools/call":
        name = params.get("name", "")
        args = params.get("arguments", {}) or {}
        cli_args = args.get("args", [])
        allow_unsafe = bool(args.get("allow_unsafe", False))

        if name == f"{TOOL_NAME}_run":
            res = run_via_adapter(cli_args, allow_unsafe=allow_unsafe)
        elif name == f"{TOOL_NAME}_describe_gate":
            res = run_via_adapter(cli_args, explain=True, dry_run=True)
        else:
            return {"jsonrpc": "2.0", "id": rid,
                    "error": {"code": -32601,
                              "message": f"unknown tool: {name}"}}

        text = (
            (f"exit_code: {res['exit_code']}\n"
             f"stdout:\n{res['stdout']}\n"
             f"stderr:\n{res['stderr']}")
            if (res["stdout"] or res["stderr"]) else
            f"exit_code: {res['exit_code']}"
        )
        return {
            "jsonrpc": "2.0", "id": rid,
            "result": {
                "content": [{"type": "text", "text": text}],
                "isError": res["exit_code"] != 0,
            },
        }

    if method == "notifications/initialized":
        return None  # notification, no response

    return {"jsonrpc": "2.0", "id": rid,
            "error": {"code": -32601, "message": f"unknown method: {method}"}}


def main():
    while True:
        msg = read_message()
        if msg is None:
            return
        resp = handle(msg)
        if resp is not None:
            write_message(resp)


if __name__ == "__main__":
    main()
